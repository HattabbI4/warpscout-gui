<Application x:Class="WarpscoutGui.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Dark" />
                <ui:ControlsDictionary />
            </ResourceDictionary.MergedDictionaries>

            <!-- Windows 11 Fluent 3D Vector Icon: Shield + Network Globe -->
            <DrawingImage x:Key="FluentShieldGlobeIcon">
                <DrawingImage.Drawing>
                    <DrawingGroup>
                        <!-- Soft ambient shadow -->
                        <GeometryDrawing>
                            <GeometryDrawing.Brush>
                                <RadialGradientBrush Center="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
                                    <GradientStop Color="#4400B7C3" Offset="0.2" />
                                    <GradientStop Color="#000078D4" Offset="1" />
                                </RadialGradientBrush>
                            </GeometryDrawing.Brush>
                            <GeometryDrawing.Geometry>
                                <EllipseGeometry Center="24,24" RadiusX="23" RadiusY="23" />
                            </GeometryDrawing.Geometry>
                        </GeometryDrawing>
                        <!-- 3D Blue/Cyan Globe -->
                        <GeometryDrawing>
                            <GeometryDrawing.Brush>
                                <LinearGradientBrush StartPoint="0.15,0.1" EndPoint="0.85,0.9">
                                    <GradientStop Color="#60CDFF" Offset="0" />
                                    <GradientStop Color="#0078D4" Offset="0.55" />
                                    <GradientStop Color="#003E92" Offset="1" />
                                </LinearGradientBrush>
                            </GeometryDrawing.Brush>
                            <GeometryDrawing.Geometry>
                                <EllipseGeometry Center="21,21" RadiusX="15" RadiusY="15" />
                            </GeometryDrawing.Geometry>
                        </GeometryDrawing>
                        <!-- Glass meridian rings -->
                        <GeometryDrawing>
                            <GeometryDrawing.Pen>
                                <Pen Thickness="1.3" Brush="#77FFFFFF" />
                            </GeometryDrawing.Pen>
                            <GeometryDrawing.Geometry>
                                <EllipseGeometry Center="21,21" RadiusX="7" RadiusY="15" />
                            </GeometryDrawing.Geometry>
                        </GeometryDrawing>
                        <GeometryDrawing>
                            <GeometryDrawing.Pen>
                                <Pen Thickness="1.2" Brush="#66FFFFFF" />
                            </GeometryDrawing.Pen>
                            <GeometryDrawing.Geometry>
                                <LineGeometry StartPoint="6.5,21" EndPoint="35.5,21" />
                            </GeometryDrawing.Geometry>
                        </GeometryDrawing>
                        <!-- Frosted Glass Shield Badge -->
                        <GeometryDrawing>
                            <GeometryDrawing.Brush>
                                <LinearGradientBrush StartPoint="0.1,0" EndPoint="0.9,1">
                                    <GradientStop Color="#E050E6FF" Offset="0" />
                                    <GradientStop Color="#E010B981" Offset="0.55" />
                                    <GradientStop Color="#F0047857" Offset="1" />
                                </LinearGradientBrush>
                            </GeometryDrawing.Brush>
                            <GeometryDrawing.Pen>
                                <Pen Thickness="1.2" Brush="#CCFFFFFF" />
                            </GeometryDrawing.Pen>
                            <GeometryDrawing.Geometry>
                                <PathGeometry Figures="M 32,20 L 42,23.5 L 42,31 C 42,37 37.5,41 32,43.5 C 26.5,41 22,37 22,31 L 22,23.5 Z" />
                            </GeometryDrawing.Geometry>
                        </GeometryDrawing>
                        <!-- Shield checkmark -->
                        <GeometryDrawing>
                            <GeometryDrawing.Pen>
                                <Pen Thickness="2.2" Brush="White" StartLineCap="Round" EndLineCap="Round" LineJoin="Round" />
                            </GeometryDrawing.Pen>
                            <GeometryDrawing.Geometry>
                                <PathGeometry Figures="M 27.5,31.5 L 30.8,34.8 L 36.8,28.2" />
                            </GeometryDrawing.Geometry>
                        </GeometryDrawing>
                    </DrawingGroup>
                </DrawingImage.Drawing>
            </DrawingImage>

            <!-- Windows 11 Fluent 3D Vector Icon: Stacked Servers -->
            <DrawingImage x:Key="FluentServerStackIcon">
                <DrawingImage.Drawing>
                    <DrawingGroup>
                        <!-- Bottom Server Blade -->
                        <GeometryDrawing>
                            <GeometryDrawing.Brush>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#4F46E5" Offset="0" />
                                    <GradientStop Color="#312E81" Offset="1" />
                                </LinearGradientBrush>
                            </GeometryDrawing.Brush>
                            <GeometryDrawing.Pen>
                                <Pen Thickness="1" Brush="#55FFFFFF" />
                            </GeometryDrawing.Pen>
                            <GeometryDrawing.Geometry>
                                <RectangleGeometry Rect="6,29,36,11" RadiusX="4" RadiusY="4" />
                            </GeometryDrawing.Geometry>
                        </GeometryDrawing>
                        <!-- Middle Server Blade -->
                        <GeometryDrawing>
                            <GeometryDrawing.Brush>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#3B82F6" Offset="0" />
                                    <GradientStop Color="#1D4ED8" Offset="1" />
                                </LinearGradientBrush>
                            </GeometryDrawing.Brush>
                            <GeometryDrawing.Pen>
                                <Pen Thickness="1" Brush="#77FFFFFF" />
                            </GeometryDrawing.Pen>
                            <GeometryDrawing.Geometry>
                                <RectangleGeometry Rect="6,17,36,11" RadiusX="4" RadiusY="4" />
                            </GeometryDrawing.Geometry>
                        </GeometryDrawing>
                        <!-- Top Server Blade -->
                        <GeometryDrawing>
                            <GeometryDrawing.Brush>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#60CDFF" Offset="0" />
                                    <GradientStop Color="#0078D4" Offset="1" />
                                </LinearGradientBrush>
                            </GeometryDrawing.Brush>
                            <GeometryDrawing.Pen>
                                <Pen Thickness="1" Brush="#99FFFFFF" />
                            </GeometryDrawing.Pen>
                            <GeometryDrawing.Geometry>
                                <RectangleGeometry Rect="6,5,36,11" RadiusX="4" RadiusY="4" />
                            </GeometryDrawing.Geometry>
                        </GeometryDrawing>
                        <!-- Status LEDs -->
                        <GeometryDrawing Brush="#6EE7B7">
                            <GeometryDrawing.Geometry>
                                <GeometryGroup>
                                    <EllipseGeometry Center="12,10.5" RadiusX="2" RadiusY="2" />
                                    <EllipseGeometry Center="12,22.5" RadiusX="2" RadiusY="2" />
                                    <EllipseGeometry Center="12,34.5" RadiusX="2" RadiusY="2" />
                                </GeometryGroup>
                            </GeometryDrawing.Geometry>
                        </GeometryDrawing>
                    </DrawingGroup>
                </DrawingImage.Drawing>
            </DrawingImage>

            <!-- Windows 11 Fluent 3D Vector Icon: Settings Gear -->
            <DrawingImage x:Key="FluentCoreGearIcon">
                <DrawingImage.Drawing>
                    <DrawingGroup>
                        <!-- Outer Gear Ring -->
                        <GeometryDrawing>
                            <GeometryDrawing.Brush>
                                <LinearGradientBrush StartPoint="0.1,0.1" EndPoint="0.9,0.9">
                                    <GradientStop Color="#94A3B8" Offset="0" />
                                    <GradientStop Color="#475569" Offset="1" />
                                </LinearGradientBrush>
                            </GeometryDrawing.Brush>
                            <GeometryDrawing.Pen>
                                <Pen Thickness="1" Brush="#88FFFFFF" />
                            </GeometryDrawing.Pen>
                            <GeometryDrawing.Geometry>
                                <PathGeometry Figures="M 20,4 L 28,4 L 29.5,9.5 L 34.5,11.5 L 39,8.5 L 44.5,14 L 41.5,18.5 L 43.5,23.5 L 49,25 L 49,33 L 43.5,34.5 L 41.5,39.5 L 44.5,44 L 39,49.5 L 34.5,46.5 L 29.5,48.5 L 28,54 L 20,54 L 18.5,48.5 L 13.5,46.5 L 9,49.5 L 3.5,44 L 6.5,39.5 L 4.5,34.5 L -1,33 L -1,25 L 4.5,23.5 L 6.5,18.5 L 3.5,14 L 9,8.5 L 13.5,11.5 L 18.5,9.5 Z" />
                            </GeometryDrawing.Geometry>
                        </GeometryDrawing>
                        <!-- Glowing Cyan Hub -->
                        <GeometryDrawing>
                            <GeometryDrawing.Brush>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#60CDFF" Offset="0" />
                                    <GradientStop Color="#0078D4" Offset="1" />
                                </LinearGradientBrush>
                            </GeometryDrawing.Brush>
                            <GeometryDrawing.Pen>
                                <Pen Thickness="1.5" Brush="#CCFFFFFF" />
                            </GeometryDrawing.Pen>
                            <GeometryDrawing.Geometry>
                                <EllipseGeometry Center="24,29" RadiusX="10" RadiusY="10" />
                            </GeometryDrawing.Geometry>
                        </GeometryDrawing>
                        <GeometryDrawing Brush="#1E293B">
                            <GeometryDrawing.Geometry>
                                <EllipseGeometry Center="24,29" RadiusX="4.5" RadiusY="4.5" />
                            </GeometryDrawing.Geometry>
                        </GeometryDrawing>
                    </DrawingGroup>
                </DrawingImage.Drawing>
            </DrawingImage>
        </ResourceDictionary>
    </Application.Resources>
</Application>
