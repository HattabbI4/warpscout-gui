<ui:FluentWindow x:Class="WarpscoutGui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:local="clr-namespace:WarpscoutGui"
        Title="Warpscout"
        Icon="pack://application:,,,/Assets/app.png"
        Width="1120"
        Height="740"
        MinWidth="980"
        MinHeight="620"
        WindowStartupLocation="CenterScreen"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica"
        WindowCornerPreference="Round">

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Native Fluent TitleBar -->
        <ui:TitleBar x:Name="AppTitleBar"
                     Grid.Row="0"
                     Title="Warpscout"
                     Height="40">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/Assets/app.png" Width="20" Height="20" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <!-- Two-Column Windows 11 Settings / MagicPods Layout -->
        <Grid Grid.Row="1" Margin="8,2,16,14">
            <Grid.Resources>
                <!-- Full-width edge-to-edge Windows 11 Settings sidebar button style -->
                <Style x:Key="SidebarNavButtonStyle" TargetType="Button">
                    <Setter Property="HorizontalAlignment" Value="Stretch" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="VerticalContentAlignment" Value="Center" />
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="BorderThickness" Value="0" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Cursor" Value="Hand" />
                    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd"
                                        Background="{TemplateBinding Background}"
                                        CornerRadius="6"
                                        SnapsToDevicePixels="True">
                                    <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                      Margin="{TemplateBinding Padding}" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="#1CFFFFFF" />
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="#10FFFFFF" />
                                    </Trigger>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter Property="Opacity" Value="0.4" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Grid.Resources>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SidebarCol" Width="232" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Left Sidebar Navigation -->
            <Grid x:Name="SidebarNavPanel" Grid.Column="0" Margin="0,0,12,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- App Identity + Clickable Core Version Status -->
                <Grid x:Name="SidebarBrandRow" Grid.Row="0" Margin="5,4,5,10" MinHeight="41">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Image Source="pack://application:,,,/Assets/app.png" Width="34" Height="34"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                    <StackPanel x:Name="SidebarBrandText" Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0">
                        <TextBlock Text="Warpscout" FontSize="14.5" FontWeight="SemiBold" Foreground="White" />
                        <Button x:Name="BtnVersionStatus"
                                Style="{StaticResource SidebarNavButtonStyle}"
                                Padding="4,2" Margin="-4,1,0,0"
                                ToolTip="{Binding TooltipCoreSettings, Source={x:Static local:Strings.Instance}}"
                                Click="BtnVersionStatus_Click">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse x:Name="StatusDot" Width="7" Height="7" Fill="#F59E0B" Margin="0,0,6,0" />
                                <TextBlock x:Name="TxtStatusPill" Text="{Binding StatusChecking, Source={x:Static local:Strings.Instance}}" FontSize="11.5" Foreground="#9CA3AF"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- 3-Line Hamburger Toggle Button (MagicPods / Win11 style) -->
                <Button x:Name="BtnToggleSidebar" Grid.Row="1"
                        Style="{StaticResource SidebarNavButtonStyle}"
                        Width="44" Height="36" HorizontalAlignment="Left" Margin="0,0,0,4"
                        ToolTip="{Binding TooltipToggleSidebar, Source={x:Static local:Strings.Instance}}"
                        Click="BtnToggleSidebar_Click">
                    <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Border Width="14" Height="1.5" Background="#E5E7EB" CornerRadius="1" Margin="0,0,0,3.5" />
                        <Border Width="14" Height="1.5" Background="#E5E7EB" CornerRadius="1" Margin="0,0,0,3.5" />
                        <Border Width="14" Height="1.5" Background="#E5E7EB" CornerRadius="1" />
                    </StackPanel>
                </Button>

                <!-- Top Navigation Items -->
                <StackPanel Grid.Row="2">
                    <!-- Nav: Scanner -->
                    <Button x:Name="NavScanner" Tag="scanner" Click="NavButton_Click"
                            Style="{StaticResource SidebarNavButtonStyle}"
                            Background="#14FFFFFF" Height="38" Margin="0,0,0,4"
                            ToolTip="{Binding NavScanner, Source={x:Static local:Strings.Instance}}">
                        <Grid>
                            <Border x:Name="IndScanner" Width="3" Height="16" CornerRadius="2"
                                    Background="#60CDFF" HorizontalAlignment="Left" VerticalAlignment="Center" />
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="13,0,12,0">
                                <ui:SymbolIcon x:Name="IconScanner" Symbol="GlobeSearch24" FontSize="18" Foreground="#60CDFF" />
                                <TextBlock x:Name="TxtNavScanner" Text="{Binding NavScanner, Source={x:Static local:Strings.Instance}}" FontSize="13.5" FontWeight="SemiBold"
                                           Foreground="White" VerticalAlignment="Center" Margin="12,0,0,0" />
                            </StackPanel>
                        </Grid>
                    </Button>

                    <!-- Nav: Advanced Scanner -->
                    <Button x:Name="NavAdvanced" Tag="advanced" Click="NavButton_Click"
                            Style="{StaticResource SidebarNavButtonStyle}"
                            Height="38" Margin="0,0,0,4"
                            ToolTip="{Binding NavAdvanced, Source={x:Static local:Strings.Instance}}">
                        <Grid>
                            <Border x:Name="IndAdvanced" Width="3" Height="16" CornerRadius="2"
                                    Background="Transparent" HorizontalAlignment="Left" VerticalAlignment="Center" />
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="13,0,12,0">
                                <ui:SymbolIcon x:Name="IconAdvanced" Symbol="Code24" FontSize="18" Foreground="#D1D5DB" />
                                <TextBlock x:Name="TxtNavAdvanced" Text="{Binding NavAdvanced, Source={x:Static local:Strings.Instance}}" FontSize="13.5"
                                           Foreground="#E5E7EB" VerticalAlignment="Center" Margin="12,0,0,0" />
                            </StackPanel>
                        </Grid>
                    </Button>

                    <!-- Nav: Servers -->
                    <Button x:Name="NavServers" Tag="servers" Click="NavButton_Click"
                            Style="{StaticResource SidebarNavButtonStyle}"
                            Height="38" Margin="0,0,0,4"
                            ToolTip="{Binding NavServers, Source={x:Static local:Strings.Instance}}">
                        <Grid>
                            <Border x:Name="IndServers" Width="3" Height="16" CornerRadius="2"
                                    Background="Transparent" HorizontalAlignment="Left" VerticalAlignment="Center" />
                            <Grid Margin="13,0,10,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <ui:SymbolIcon x:Name="IconServers" Symbol="Server24" FontSize="18" Foreground="#D1D5DB" />
                                    <TextBlock x:Name="TxtNavServers" Text="{Binding NavServers, Source={x:Static local:Strings.Instance}}" FontSize="13.5"
                                               Foreground="#E5E7EB" VerticalAlignment="Center" Margin="12,0,0,0" />
                                </StackPanel>
                                <Border x:Name="NavServersBadge" Grid.Column="1" Visibility="Collapsed"
                                        Background="#263B82F6" CornerRadius="10" Padding="7,1" VerticalAlignment="Center">
                                    <TextBlock x:Name="TxtNavServersBadge" Text="0" FontSize="11" FontWeight="SemiBold" Foreground="#93C5FD" />
                                </Border>
                            </Grid>
                        </Grid>
                    </Button>
                </StackPanel>

                <!-- Bottom Pinned Nav: Settings -->
                <Button x:Name="NavSettings" Grid.Row="3" Tag="settings" Click="NavButton_Click"
                        Style="{StaticResource SidebarNavButtonStyle}"
                        Height="38" Margin="0,4,0,0"
                        ToolTip="{Binding NavSettings, Source={x:Static local:Strings.Instance}}">
                    <Grid>
                        <Border x:Name="IndSettings" Width="3" Height="16" CornerRadius="2"
                                Background="Transparent" HorizontalAlignment="Left" VerticalAlignment="Center" />
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="13,0,12,0">
                            <ui:SymbolIcon x:Name="IconSettings" Symbol="Settings24" FontSize="18" Foreground="#D1D5DB" />
                            <TextBlock x:Name="TxtNavSettings" Text="{Binding NavSettings, Source={x:Static local:Strings.Instance}}" FontSize="13.5"
                                       Foreground="#E5E7EB" VerticalAlignment="Center" Margin="12,0,0,0" />
                        </StackPanel>
                    </Grid>
                </Button>
            </Grid>

            <!-- Right Content Area -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Global Top Banners (Download Progress, Errors, Active SOCKS5) -->
                <StackPanel Grid.Row="0">
                    <!-- Explicit Core Download Progress Banner -->
                    <Border x:Name="CoreDownloadPanel"
                            Visibility="Collapsed"
                            Background="#1A0078D4"
                            BorderBrush="#660078D4"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="14,10"
                            Margin="0,0,0,10">
                        <StackPanel>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <ui:SymbolIcon Symbol="ArrowDownload24" Margin="0,0,8,0" Foreground="#60CDFF" />
                                    <TextBlock Text="{Binding CoreDownloadTitle, Source={x:Static local:Strings.Instance}}"
                                               FontWeight="SemiBold" FontSize="13" Foreground="White" />
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{Binding CoreDownloadLockNote, Source={x:Static local:Strings.Instance}}"
                                           FontSize="11.5" Foreground="#93C5FD" VerticalAlignment="Center" />
                            </Grid>
                            <TextBlock x:Name="TxtCoreDownloadStatus" Text="{Binding CoreDownloadConnecting, Source={x:Static local:Strings.Instance}}"
                                       FontSize="12" Foreground="#E5E7EB" Margin="0,0,0,6" />
                            <ProgressBar x:Name="PbCoreDownload" Height="6" Minimum="0" Maximum="100" Value="0" />
                        </StackPanel>
                    </Border>

                    <!-- Explicit Core Error / Info Notification Banner -->
                    <Border x:Name="CoreNoticePanel"
                            Visibility="Collapsed"
                            CornerRadius="8"
                            Padding="14,10"
                            Margin="0,0,0,10"
                            BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                <TextBlock x:Name="TxtCoreNoticeTitle" FontWeight="SemiBold" FontSize="13" Foreground="White" />
                                <TextBlock x:Name="TxtCoreNoticeMessage" FontSize="12" Foreground="#E5E7EB"
                                           TextWrapping="Wrap" Margin="0,2,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <ui:Button x:Name="BtnRetryDownload" Content="{Binding BtnRetry, Source={x:Static local:Strings.Instance}}" Appearance="Secondary"
                                           Margin="0,0,6,0" Click="BtnUpdateCore_Click" />
                                <ui:Button x:Name="BtnPickCoreFromError" Content="{Binding BtnBrowse, Source={x:Static local:Strings.Instance}}" Appearance="Secondary"
                                           Margin="0,0,6,0" Click="BtnBrowseCore_Click" />
                                <ui:Button Content="{Binding BtnHide, Source={x:Static local:Strings.Instance}}" Appearance="Transparent"
                                           Click="BtnDismissCoreNotice_Click" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Active SOCKS5 Proxy Banner -->
                    <Border x:Name="SocksBanner"
                            Visibility="Collapsed"
                            Background="#1F10B981"
                            BorderBrush="#6610B981"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="14,8"
                            Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <ui:SymbolIcon Symbol="PlugConnected24" Margin="0,0,8,0" Foreground="#34D399" />
                                <TextBlock x:Name="TxtSocksBanner"
                                           VerticalAlignment="Center"
                                           FontSize="12.5"
                                           Foreground="#A7F3D0"
                                           Text="SOCKS5: 127.0.0.1:1080" />
                            </StackPanel>
                            <ui:Button x:Name="BtnStopSocks"
                                       Grid.Column="1"
                                       Content="{Binding BtnStopSocks, Source={x:Static local:Strings.Instance}}"
                                       Appearance="Danger"
                                       Padding="10,4"
                                       Click="BtnStopSocks_Click" />
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- Pages Host -->
                <Grid x:Name="MainWorkspace" Grid.Row="1">

                    <!-- ==================== PAGE 1: SCANNER ==================== -->
                    <ScrollViewer x:Name="PageScanner" VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
                        <StackPanel Margin="0,0,0,42">
                            <TextBlock x:Name="TxtScannerPageTitle" Text="{Binding ScannerTitle, Source={x:Static local:Strings.Instance}}" FontSize="26" FontWeight="SemiBold"
                                       Foreground="White" Margin="0,0,0,14" />

                            <!-- Hero Card (Win11 Settings / MagicPods style) -->
                            <Border Background="#14FFFFFF" BorderBrush="#1FFFFFFF" BorderThickness="1"
                                    CornerRadius="8" Padding="18,16" Margin="0,0,0,10">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <Image Source="{StaticResource FluentShieldGlobeIcon}"
                                               Width="48" Height="48" Margin="0,0,16,0"
                                               RenderOptions.BitmapScalingMode="HighQuality" />

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                                            <TextBlock x:Name="TxtHeroTitle"
                                                       Text="{Binding HeroReady, Source={x:Static local:Strings.Instance}}"
                                                       FontSize="15.5" FontWeight="SemiBold" Foreground="White" />
                                            <TextBlock x:Name="TxtHeroSubtitle"
                                                       Text=""
                                                       FontSize="12" Foreground="#9CA3AF" Margin="0,3,0,0" />
                                        </StackPanel>

                                        <ui:Button x:Name="BtnScan"
                                                   Grid.Column="2"
                                                   Content="{Binding BtnFindServers, Source={x:Static local:Strings.Instance}}"
                                                   Icon="{ui:SymbolIcon Play24}"
                                                   Appearance="Primary"
                                                   MinWidth="175"
                                                   Height="38"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   Click="BtnScan_Click" />
                                    </Grid>

                                    <!-- Embedded Scan Progress Section -->
                                    <StackPanel x:Name="ScanProgressCard" Visibility="Collapsed" Margin="0,14,0,0">
                                        <Border BorderBrush="#1AFFFFFF" BorderThickness="0,1,0,0" Padding="0,12,0,0">
                                            <StackPanel>
                                                <Grid Margin="0,0,0,6">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock x:Name="TxtScanPhase" Text="{Binding ScanPreparing, Source={x:Static local:Strings.Instance}}" FontSize="12" Foreground="#E5E7EB"
                                                               VerticalAlignment="Center" />
                                                    <TextBlock x:Name="TxtScanCount" Grid.Column="1" Text=""
                                                               FontSize="12" FontWeight="SemiBold" Foreground="#60CDFF"
                                                               VerticalAlignment="Center" Margin="12,0,10,0" />
                                                    <ui:Button x:Name="BtnToggleScanLogs" Grid.Column="2"
                                                               Content="{Binding BtnShowLog, Source={x:Static local:Strings.Instance}}"
                                                               Appearance="Secondary"
                                                               Padding="8,3" FontSize="11.5"
                                                               Click="BtnToggleScanLogs_Click" />
                                                </Grid>
                                                <ProgressBar x:Name="PbScan" Height="5" Minimum="0" Maximum="100" Value="0" />
                                                <Border x:Name="ScanLogsPanel" Visibility="Collapsed"
                                                        Background="#0D1117" BorderBrush="#26FFFFFF" BorderThickness="1"
                                                        CornerRadius="6" Padding="2" Margin="0,8,0,0">
                                                    <TextBox x:Name="TxtScanLogs"
                                                             IsReadOnly="True"
                                                             AcceptsReturn="True"
                                                             TextWrapping="NoWrap"
                                                             VerticalScrollBarVisibility="Auto"
                                                             HorizontalScrollBarVisibility="Auto"
                                                             Height="165"
                                                             Background="Transparent"
                                                             Foreground="#D1D5DB"
                                                             BorderThickness="0"
                                                             FontFamily="Consolas"
                                                             FontSize="11.5"
                                                             Padding="8,6" />
                                                </Border>
                                                <Border x:Name="ScanErrorBox" Visibility="Collapsed"
                                                        Background="#26EF4444" BorderBrush="#66EF4444" BorderThickness="1"
                                                        CornerRadius="6" Padding="10,7" Margin="0,8,0,0">
                                                    <TextBlock x:Name="TxtScanError" Foreground="#FCA5A5" FontSize="12" TextWrapping="Wrap" />
                                                </Border>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Best Server Quick Action Card -->
                            <Border x:Name="BestServerCard"
                                    Visibility="Collapsed"
                                    Background="#1410B981"
                                    BorderBrush="#4410B981"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="16,12"
                                    Margin="0,0,0,14">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                        <TextBlock x:Name="TxtBestTitle" Text=""
                                                   FontSize="13.5" FontWeight="SemiBold" Foreground="#6EE7B7" />
                                        <TextBlock x:Name="TxtBestSubtitle" Text="—"
                                                   FontSize="12" Foreground="#D1D5DB" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <ui:Button x:Name="BtnBestDownload" Content="{Binding BtnBestDownload, Source={x:Static local:Strings.Instance}}"
                                                   Icon="{ui:SymbolIcon ArrowDownload24}"
                                                   Appearance="Secondary" Margin="0,0,6,0"
                                                   Click="BtnBestDownload_Click" />
                                        <ui:Button x:Name="BtnBestProxy" Content="{Binding BtnProxyStart, Source={x:Static local:Strings.Instance}}"
                                                   Icon="{ui:SymbolIcon PlugConnected24}"
                                                   Appearance="Primary" Margin="0,0,6,0"
                                                   Click="BtnBestProxy_Click" />
                                        <ui:Button Content="{Binding BtnAllServers, Source={x:Static local:Strings.Instance}}"
                                                   Icon="{ui:SymbolIcon ArrowRight24}"
                                                   Appearance="Transparent"
                                                   Click="BtnGoToServers_Click" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Section Header: Scan Parameters -->
                            <TextBlock Text="{Binding ScanParamsHeader, Source={x:Static local:Strings.Instance}}" FontSize="13.5" FontWeight="SemiBold"
                                       Foreground="#E5E7EB" Margin="2,6,0,8" />

                            <StackPanel x:Name="ScanOptionsCards">
                                <!-- Protocol -->
                                <ui:CardControl Icon="{ui:SymbolIcon ShieldGlobe24}" Margin="0,0,0,4">
                                    <ui:CardControl.Header>
                                        <StackPanel>
                                            <TextBlock Text="{Binding ProtoTitle, Source={x:Static local:Strings.Instance}}" FontSize="13.5" FontWeight="Medium" Foreground="White" />
                                            <TextBlock Text="{Binding ProtoDesc, Source={x:Static local:Strings.Instance}}" FontSize="11.5" Foreground="#9CA3AF" />
                                        </StackPanel>
                                    </ui:CardControl.Header>
                                    <ComboBox x:Name="CmbProto" Width="200" SelectedIndex="0" SelectionChanged="CmbProto_SelectionChanged">
                                        <ComboBoxItem Tag="awg" Content="AmneziaWG" />
                                        <ComboBoxItem Tag="awg31" Content="AmneziaWG 3.1" />
                                        <ComboBoxItem Tag="wg" Content="WireGuard" />
                                        <ComboBoxItem Tag="masque" Content="MASQUE (QUIC)" />
                                        <ComboBoxItem Tag="masque-h2" Content="MASQUE H2 (TCP)" />
                                    </ComboBox>
                                </ui:CardControl>

                                <!-- AmneziaWG 3.1 Parameters (shown only when awg31 is selected) -->
                                <ui:CardExpander x:Name="CardAwg31"
                                                 Icon="{ui:SymbolIcon Options24}"
                                                 Visibility="Collapsed"
                                                 IsExpanded="True"
                                                 ContentPadding="16,12"
                                                 Margin="0,0,0,4">
                                    <ui:CardExpander.Header>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Awg31CardTitle, Source={x:Static local:Strings.Instance}}"
                                                       FontSize="13.5" FontWeight="Medium" Foreground="White" />
                                            <TextBlock x:Name="TxtAwg31CardDesc"
                                                       Text="{Binding Awg31CardDefaultDesc, Source={x:Static local:Strings.Instance}}"
                                                       FontSize="11.5" Foreground="#9CA3AF" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </ui:CardExpander.Header>
                                    <StackPanel>
                                        <!-- Padding -->
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                                <TextBlock Text="{Binding Awg31PaddingTitle, Source={x:Static local:Strings.Instance}}"
                                                           FontSize="13" FontWeight="Medium" Foreground="White" />
                                                <TextBlock Text="{Binding Awg31PaddingDesc, Source={x:Static local:Strings.Instance}}"
                                                           FontSize="11.5" Foreground="#9CA3AF" TextWrapping="Wrap" />
                                            </StackPanel>
                                            <ui:TextBox x:Name="TxtAwg31Padding"
                                                        Grid.Column="1"
                                                        Width="155"
                                                        PlaceholderText="{Binding Awg31PaddingPlaceholder, Source={x:Static local:Strings.Instance}}"
                                                        FontFamily="Consolas"
                                                        VerticalAlignment="Center"
                                                        TextChanged="Awg31Option_TextChanged"
                                                        LostFocus="Awg31Option_LostFocus" />
                                        </Grid>

                                        <!-- Random Trailers -->
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                                <TextBlock Text="{Binding Awg31RandomTrailersTitle, Source={x:Static local:Strings.Instance}}"
                                                           FontSize="13" FontWeight="Medium" Foreground="White" />
                                                <TextBlock Text="{Binding Awg31RandomTrailersDesc, Source={x:Static local:Strings.Instance}}"
                                                           FontSize="11.5" Foreground="#9CA3AF" TextWrapping="Wrap" />
                                            </StackPanel>
                                            <ui:ToggleSwitch x:Name="ChkAwg31RandomTrailers"
                                                             Grid.Column="1"
                                                             IsChecked="False"
                                                             VerticalAlignment="Center"
                                                             Checked="Awg31Option_ToggleChanged"
                                                             Unchecked="Awg31Option_ToggleChanged" />
                                        </Grid>

                                        <!-- Disable Cookies -->
                                        <Grid Margin="0,0,0,12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                                <TextBlock Text="{Binding Awg31DisableCookiesTitle, Source={x:Static local:Strings.Instance}}"
                                                           FontSize="13" FontWeight="Medium" Foreground="White" />
                                                <TextBlock Text="{Binding Awg31DisableCookiesDesc, Source={x:Static local:Strings.Instance}}"
                                                           FontSize="11.5" Foreground="#9CA3AF" TextWrapping="Wrap" />
                                            </StackPanel>
                                            <ui:ToggleSwitch x:Name="ChkAwg31DisableCookies"
                                                             Grid.Column="1"
                                                             IsChecked="False"
                                                             VerticalAlignment="Center"
                                                             Checked="Awg31Option_ToggleChanged"
                                                             Unchecked="Awg31Option_ToggleChanged" />
                                        </Grid>

                                        <Border BorderBrush="#1AFFFFFF" BorderThickness="0,1,0,0" Margin="0,0,0,10" />

                                        <TextBlock Text="{Binding Awg31TimingsHeader, Source={x:Static local:Strings.Instance}}"
                                                   FontSize="12" FontWeight="SemiBold" Foreground="#D1D5DB" Margin="0,0,0,8" />

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="12" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,8">
                                                <TextBlock Text="{Binding Awg31RekeyAfterLabel, Source={x:Static local:Strings.Instance}}"
                                                           FontSize="11.5" Foreground="#9CA3AF" Margin="0,0,0,4" />
                                                <ui:TextBox x:Name="TxtAwg31RekeyAfter"
                                                            PlaceholderText="{Binding Awg31RekeyAfterPlaceholder, Source={x:Static local:Strings.Instance}}"
                                                            FontFamily="Consolas"
                                                            TextChanged="Awg31Option_TextChanged"
                                                            LostFocus="Awg31Option_LostFocus" />
                                            </StackPanel>

                                            <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,8">
                                                <TextBlock Text="{Binding Awg31RejectAfterLabel, Source={x:Static local:Strings.Instance}}"
                                                           FontSize="11.5" Foreground="#9CA3AF" Margin="0,0,0,4" />
                                                <ui:TextBox x:Name="TxtAwg31RejectAfter"
                                                            PlaceholderText="{Binding Awg31RejectAfterPlaceholder, Source={x:Static local:Strings.Instance}}"
                                                            FontFamily="Consolas"
                                                            ToolTip="{Binding Awg31RejectAfterTooltip, Source={x:Static local:Strings.Instance}}"
                                                            TextChanged="Awg31Option_TextChanged"
                                                            LostFocus="Awg31Option_LostFocus" />
                                            </StackPanel>

                                            <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,0,8">
                                                <TextBlock Text="{Binding Awg31RekeyTimeoutLabel, Source={x:Static local:Strings.Instance}}"
                                                           FontSize="11.5" Foreground="#9CA3AF" Margin="0,0,0,4" />
                                                <ui:TextBox x:Name="TxtAwg31RekeyTimeout"
                                                            PlaceholderText="{Binding Awg31RekeyTimeoutPlaceholder, Source={x:Static local:Strings.Instance}}"
                                                            FontFamily="Consolas"
                                                            TextChanged="Awg31Option_TextChanged"
                                                            LostFocus="Awg31Option_LostFocus" />
                                            </StackPanel>

                                            <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,0,8">
                                                <TextBlock Text="{Binding Awg31KeepaliveTimeoutLabel, Source={x:Static local:Strings.Instance}}"
                                                           FontSize="11.5" Foreground="#9CA3AF" Margin="0,0,0,4" />
                                                <ui:TextBox x:Name="TxtAwg31KeepaliveTimeout"
                                                            PlaceholderText="{Binding Awg31KeepaliveTimeoutPlaceholder, Source={x:Static local:Strings.Instance}}"
                                                            FontFamily="Consolas"
                                                            TextChanged="Awg31Option_TextChanged"
                                                            LostFocus="Awg31Option_LostFocus" />
                                            </StackPanel>

                                            <StackPanel Grid.Row="2" Grid.Column="0">
                                                <TextBlock Text="{Binding Awg31MaxHandshakesLabel, Source={x:Static local:Strings.Instance}}"
                                                           FontSize="11.5" Foreground="#9CA3AF" Margin="0,0,0,4" />
                                                <ui:TextBox x:Name="TxtAwg31MaxHandshakes"
                                                            PlaceholderText="{Binding Awg31MaxHandshakesPlaceholder, Source={x:Static local:Strings.Instance}}"
                                                            FontFamily="Consolas"
                                                            TextChanged="Awg31Option_TextChanged"
                                                            LostFocus="Awg31Option_LostFocus" />
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </ui:CardExpander>

                                <!-- Exclude Node -->
                                <ui:CardControl x:Name="CardExcludeNode"
                                                Icon="{ui:SymbolIcon LocationOff24}"
                                                Margin="0,0,0,4"
                                                ToolTipService.ShowOnDisabled="True">
                                    <ui:CardControl.Header>
                                        <StackPanel>
                                            <TextBlock Text="{Binding ExcludeNodeTitle, Source={x:Static local:Strings.Instance}}" FontSize="13.5" FontWeight="Medium" Foreground="White" />
                                            <TextBlock Text="{Binding ExcludeNodeDesc, Source={x:Static local:Strings.Instance}}" FontSize="11.5" Foreground="#9CA3AF" />
                                        </StackPanel>
                                    </ui:CardControl.Header>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <ui:TextBox x:Name="TxtExcludeNode"
                                                    Width="110"
                                                    Text="DME"
                                                    PlaceholderText="{Binding ExcludeNodePlaceholder, Source={x:Static local:Strings.Instance}}"
                                                    FontFamily="Consolas"
                                                    Margin="0,0,12,0"
                                                    IsEnabled="{Binding IsChecked, ElementName=ChkDme}"
                                                    TextChanged="TxtExcludeNode_TextChanged"
                                                    LostFocus="TxtExcludeNode_LostFocus" />
                                        <ui:ToggleSwitch x:Name="ChkDme" IsChecked="True"
                                                         Checked="ScanOption_Changed" Unchecked="ScanOption_Changed" />
                                    </StackPanel>
                                </ui:CardControl>

                                <!-- Tun Ping -->
                                <ui:CardControl Icon="{ui:SymbolIcon Pulse24}" Margin="0,0,0,4">
                                    <ui:CardControl.Header>
                                        <StackPanel>
                                            <TextBlock Text="{Binding TunPingTitle, Source={x:Static local:Strings.Instance}}" FontSize="13.5" FontWeight="Medium" Foreground="White" />
                                            <TextBlock Text="{Binding TunPingDesc, Source={x:Static local:Strings.Instance}}" FontSize="11.5" Foreground="#9CA3AF" />
                                        </StackPanel>
                                    </ui:CardControl.Header>
                                    <ui:ToggleSwitch x:Name="ChkPing" IsChecked="True"
                                                     Checked="ScanOption_Changed" Unchecked="ScanOption_Changed" />
                                </ui:CardControl>

                                <!-- Full Scan -->
                                <ui:CardControl Icon="{ui:SymbolIcon Grid24}" Margin="0,0,0,4">
                                    <ui:CardControl.Header>
                                        <StackPanel>
                                            <TextBlock Text="{Binding FullScanTitle, Source={x:Static local:Strings.Instance}}" FontSize="13.5" FontWeight="Medium" Foreground="White" />
                                            <TextBlock Text="{Binding FullScanDesc, Source={x:Static local:Strings.Instance}}" FontSize="11.5" Foreground="#9CA3AF" />
                                        </StackPanel>
                                    </ui:CardControl.Header>
                                    <ui:ToggleSwitch x:Name="ChkFull" IsChecked="False"
                                                     Checked="ScanOption_Changed" Unchecked="ScanOption_Changed" />
                                </ui:CardControl>

                                <!-- Speed Test -->
                                <ui:CardControl Icon="{ui:SymbolIcon TopSpeed24}" Margin="0,0,0,4">
                                    <ui:CardControl.Header>
                                        <StackPanel>
                                            <TextBlock Text="{Binding SpeedTestTitle, Source={x:Static local:Strings.Instance}}" FontSize="13.5" FontWeight="Medium" Foreground="White" />
                                            <TextBlock Text="{Binding SpeedTestDesc, Source={x:Static local:Strings.Instance}}" FontSize="11.5" Foreground="#9CA3AF" />
                                        </StackPanel>
                                    </ui:CardControl.Header>
                                    <ui:ToggleSwitch x:Name="ChkSpeed" IsChecked="False"
                                                     Checked="ScanOption_Changed" Unchecked="ScanOption_Changed" />
                                </ui:CardControl>
                            </StackPanel>

                            <Border x:Name="AdvancedOptionsCard"
                                    Visibility="Collapsed"
                                    Background="#14FFFFFF"
                                    BorderBrush="#1FFFFFFF"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="16,14"
                                    Margin="0,0,0,4">
                                <StackPanel>
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <ui:SymbolIcon Symbol="Code24" FontSize="20" Foreground="#60CDFF" Margin="0,2,10,0" VerticalAlignment="Top" />
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding AdvFlagsTitle, Source={x:Static local:Strings.Instance}}" FontSize="13.5" FontWeight="Medium" Foreground="White" />
                                            <TextBlock Text="{Binding AdvFlagsDesc, Source={x:Static local:Strings.Instance}}"
                                                       FontSize="11.5" Foreground="#9CA3AF" TextWrapping="Wrap" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </Grid>
                                    <ui:TextBox x:Name="TxtCustomFlags"
                                                PlaceholderText="{Binding AdvFlagsPlaceholder, Source={x:Static local:Strings.Instance}}"
                                                FontFamily="Consolas"
                                                FontSize="13"
                                                Margin="0,8,0,6"
                                                TextChanged="TxtCustomFlags_TextChanged"
                                                LostFocus="TxtCustomFlags_LostFocus" />
                                    <TextBlock Text="{Binding AdvFlagsExamples, Source={x:Static local:Strings.Instance}}"
                                               FontSize="11.5" Foreground="#9CA3AF" FontFamily="Consolas" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- ==================== PAGE 2: SERVERS ==================== -->
                    <Grid x:Name="PageServers" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Image Source="{StaticResource FluentServerStackIcon}"
                                   Width="42" Height="42" Margin="0,0,14,0"
                                   RenderOptions.BitmapScalingMode="HighQuality" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                                <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding ServersTitle, Source={x:Static local:Strings.Instance}}"
                                               FontSize="26" FontWeight="SemiBold" Foreground="White"
                                               Margin="0,0,12,0" />
                                    <Border x:Name="LastScanBadge"
                                            Visibility="Collapsed"
                                            Background="#18FFFFFF"
                                            BorderBrush="#26FFFFFF"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Padding="8,3"
                                            Margin="0,4,0,0"
                                            VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <ui:SymbolIcon Symbol="Clock24" FontSize="13" Foreground="#9CA3AF" Margin="0,0,5,0" />
                                            <TextBlock x:Name="TxtLastScanTime" FontSize="11.5" Foreground="#D1D5DB" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Border>
                                </WrapPanel>
                                <TextBlock x:Name="TxtServersSubtitle"
                                           Text="{Binding ServersSubtitle, Source={x:Static local:Strings.Instance}}"
                                           FontSize="12" Foreground="#9CA3AF" />
                            </StackPanel>
                            <ui:Button x:Name="BtnRefreshServers"
                                       Grid.Column="2"
                                       Content="{Binding BtnFindServers, Source={x:Static local:Strings.Instance}}"
                                       Icon="{ui:SymbolIcon ArrowSync24}"
                                       Appearance="Primary"
                                       VerticalAlignment="Center"
                                       Click="BtnScan_Click" />
                        </Grid>

                        <Border Grid.Row="1" Background="#14FFFFFF" BorderBrush="#1FFFFFFF" BorderThickness="1" CornerRadius="8">
                            <Grid>
                                <DataGrid x:Name="GridEndpoints"
                                          AutoGenerateColumns="False"
                                          IsReadOnly="True"
                                          CanUserAddRows="False"
                                          CanUserDeleteRows="False"
                                          CanUserResizeRows="False"
                                          HeadersVisibility="Column"
                                          GridLinesVisibility="Horizontal"
                                          HorizontalGridLinesBrush="#18FFFFFF"
                                          SelectionMode="Single"
                                          Background="Transparent"
                                          BorderThickness="0"
                                          RowHeight="40">
                                    <DataGrid.Columns>
                                        <DataGridTemplateColumn Header="{Binding ColLocation, Source={x:Static local:Strings.Instance}}" Width="144">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0">
                                                        <Border Background="#2A3441" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                                                            <TextBlock Text="{Binding CountryBadge}" FontSize="11" FontWeight="Bold" Foreground="#E2E8F0" />
                                                        </Border>
                                                        <TextBlock Text="{Binding DisplayLocation}" FontSize="12.5" Foreground="#F3F4F6"
                                                                   VerticalAlignment="Center" />
                                                        <Border Background="#2B10B981" CornerRadius="8" Padding="6,1" Margin="8,0,0,0">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsBest}" Value="True">
                                                                            <Setter Property="Visibility" Value="Visible" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <TextBlock Text="★" FontSize="10.5" FontWeight="Bold" Foreground="#6EE7B7" />
                                                        </Border>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>

                                        <DataGridTemplateColumn Header="{Binding ColNode, Source={x:Static local:Strings.Instance}}" Width="56">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Border Background="#243B82F6" CornerRadius="4" Padding="7,2"
                                                            HorizontalAlignment="Left" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding DisplayNode}" FontFamily="Consolas"
                                                                   FontSize="11.5" FontWeight="SemiBold" Foreground="#93C5FD" />
                                                    </Border>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>

                                        <DataGridTemplateColumn Header="{Binding ColEndpoint, Source={x:Static local:Strings.Instance}}" Width="172">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <ui:Button Content="{Binding Endpoint}"
                                                               Appearance="Transparent"
                                                               Padding="6,3"
                                                               FontFamily="Consolas"
                                                               FontSize="12"
                                                               Foreground="#F9FAFB"
                                                               Click="BtnCopyEndpoint_Click" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>

                                        <DataGridTemplateColumn Header="{Binding ColPing, Source={x:Static local:Strings.Instance}}" Width="68">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding DisplayPing}"
                                                               Foreground="{Binding PingBrush}"
                                                               FontWeight="SemiBold"
                                                               FontSize="12.5"
                                                               VerticalAlignment="Center"
                                                               Margin="6,0" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>

                                        <DataGridTextColumn Header="{Binding ColLoss, Source={x:Static local:Strings.Instance}}" Width="56" Binding="{Binding DisplayLoss}" />
                                        <DataGridTextColumn Header="{Binding ColSpeed, Source={x:Static local:Strings.Instance}}" Width="96" Binding="{Binding DisplaySpeed}" />

                                        <DataGridTemplateColumn Header="{Binding ColActions, Source={x:Static local:Strings.Instance}}" Width="*">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <ui:Button Content="{Binding BtnRowConf, Source={x:Static local:Strings.Instance}}"
                                                                   Appearance="Secondary"
                                                                   Padding="9,4"
                                                                   FontSize="11.5"
                                                                   Margin="0,0,6,0"
                                                                   Tag="{Binding}"
                                                                   Click="BtnDownloadConf_Click" />
                                                        <ui:Button Content="{Binding ProxyButtonText}"
                                                                   Appearance="Secondary"
                                                                   Padding="9,4"
                                                                   FontSize="11.5"
                                                                   Tag="{Binding}"
                                                                   Click="BtnToggleSocks_Click" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>

                                <StackPanel x:Name="EmptyTablePanel" VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <TextBlock x:Name="TxtEmptyTable"
                                               Text="{Binding EmptyTableInitial, Source={x:Static local:Strings.Instance}}"
                                               FontSize="13.5" Foreground="#9CA3AF" HorizontalAlignment="Center" Margin="0,0,0,10" />
                                    <ui:Button Content="{Binding BtnGoToScanner, Source={x:Static local:Strings.Instance}}" Appearance="Secondary"
                                               HorizontalAlignment="Center" Click="BtnGoToScanner_Click" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- ==================== PAGE 3: SETTINGS ==================== -->
                    <ScrollViewer x:Name="PageSettings" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
                        <StackPanel Margin="0,0,0,44">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,14">
                                <Image Source="{StaticResource FluentCoreGearIcon}"
                                       Width="42" Height="42" Margin="0,0,14,0"
                                       RenderOptions.BitmapScalingMode="HighQuality" />
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding SettingsTitle, Source={x:Static local:Strings.Instance}}" FontSize="26" FontWeight="SemiBold" Foreground="White" />
                                    <TextBlock Text="{Binding SettingsSubtitle, Source={x:Static local:Strings.Instance}}"
                                               FontSize="12" Foreground="#9CA3AF" />
                                </StackPanel>
                            </StackPanel>

                            <TextBlock Text="{Binding CoreSectionHeader, Source={x:Static local:Strings.Instance}}" FontSize="13.5" FontWeight="SemiBold"
                                       Foreground="#E5E7EB" Margin="2,4,0,8" />

                            <ui:CardControl Icon="{ui:SymbolIcon FolderOpen24}" Margin="0,0,0,4">
                                <ui:CardControl.Header>
                                    <StackPanel>
                                        <TextBlock Text="{Binding CoreBinaryTitle, Source={x:Static local:Strings.Instance}}" FontSize="13.5" FontWeight="Medium" Foreground="White" />
                                        <TextBlock Text="{Binding CoreBinaryDesc, Source={x:Static local:Strings.Instance}}"
                                                   FontSize="11.5" Foreground="#9CA3AF" TextWrapping="Wrap" />
                                    </StackPanel>
                                </ui:CardControl.Header>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <ui:TextBox x:Name="TxtCorePath"
                                                Width="250"
                                                PlaceholderText="{Binding CorePathPlaceholder, Source={x:Static local:Strings.Instance}}"
                                                Margin="0,0,8,0"
                                                LostFocus="TxtCorePath_LostFocus"
                                                KeyDown="TxtCorePath_KeyDown" />
                                    <ui:Button x:Name="BtnBrowseCore"
                                               Content="{Binding BtnBrowse, Source={x:Static local:Strings.Instance}}"
                                               Icon="{ui:SymbolIcon FolderOpen24}"
                                               Appearance="Secondary"
                                               Click="BtnBrowseCore_Click" />
                                </StackPanel>
                            </ui:CardControl>

                            <ui:CardControl Icon="{ui:SymbolIcon ArrowSync24}" Margin="0,0,0,14">
                                <ui:CardControl.Header>
                                    <StackPanel>
                                        <TextBlock Text="{Binding CoreUpdateTitle, Source={x:Static local:Strings.Instance}}" FontSize="13.5" FontWeight="Medium" Foreground="White" />
                                        <TextBlock x:Name="TxtCoreVersionCard" Text="{Binding CoreVersionChecking, Source={x:Static local:Strings.Instance}}" FontSize="11.5" Foreground="#9CA3AF" />
                                    </StackPanel>
                                </ui:CardControl.Header>
                                <ui:Button x:Name="BtnCheckDownloadCore"
                                           Content="{Binding BtnCheckUpdates, Source={x:Static local:Strings.Instance}}"
                                           Icon="{ui:SymbolIcon ArrowDownload24}"
                                           Appearance="Primary"
                                           Click="BtnUpdateCore_Click" />
                            </ui:CardControl>

                            <TextBlock Text="{Binding AccountSectionHeader, Source={x:Static local:Strings.Instance}}" FontSize="13.5" FontWeight="SemiBold"
                                       Foreground="#E5E7EB" Margin="2,4,0,8" />

                            <ui:CardControl Icon="{ui:SymbolIcon Key24}" Margin="0,0,0,14">
                                <ui:CardControl.Header>
                                    <StackPanel>
                                        <TextBlock Text="{Binding AccountKeyTitle, Source={x:Static local:Strings.Instance}}" FontSize="13.5" FontWeight="Medium" Foreground="White" />
                                        <TextBlock x:Name="TxtAccountDetails" Text="{Binding AccountChecking, Source={x:Static local:Strings.Instance}}" FontSize="11.5" Foreground="#9CA3AF" />
                                    </StackPanel>
                                </ui:CardControl.Header>
                                <ui:Button x:Name="BtnRegisterAccount"
                                           Content="{Binding BtnRegenerateKey, Source={x:Static local:Strings.Instance}}"
                                           Appearance="Secondary"
                                           Click="BtnRegisterAccount_Click" />
                            </ui:CardControl>

                            <TextBlock Text="{Binding AppSectionHeader, Source={x:Static local:Strings.Instance}}" FontSize="13.5" FontWeight="SemiBold"
                                       Foreground="#E5E7EB" Margin="2,4,0,8" />

                            <ui:CardControl Icon="{ui:SymbolIcon LocalLanguage24}" Margin="0,0,0,4">
                                <ui:CardControl.Header>
                                    <StackPanel>
                                        <TextBlock Text="{Binding LanguageTitle, Source={x:Static local:Strings.Instance}}" FontSize="13.5" FontWeight="Medium" Foreground="White" />
                                        <TextBlock Text="{Binding LanguageDesc, Source={x:Static local:Strings.Instance}}" FontSize="11.5" Foreground="#9CA3AF" />
                                    </StackPanel>
                                </ui:CardControl.Header>
                                <ComboBox x:Name="CmbLanguage" Width="170" SelectedIndex="0" SelectionChanged="CmbLanguage_SelectionChanged">
                                    <ComboBoxItem Tag="ru" Content="Русский (RU)" />
                                    <ComboBoxItem Tag="en" Content="English (EN)" />
                                </ComboBox>
                            </ui:CardControl>

                            <ui:CardControl Icon="{ui:SymbolIcon AppGeneric24}" Margin="0,0,0,4">
                                <ui:CardControl.Header>
                                    <StackPanel>
                                        <TextBlock Text="{Binding TrayTitle, Source={x:Static local:Strings.Instance}}" FontSize="13.5" FontWeight="Medium" Foreground="White" />
                                        <TextBlock Text="{Binding TrayDesc, Source={x:Static local:Strings.Instance}}" FontSize="11.5" Foreground="#9CA3AF" />
                                    </StackPanel>
                                </ui:CardControl.Header>
                                <ui:ToggleSwitch x:Name="TglMinimizeToTray" IsChecked="False"
                                                 Checked="SettingsToggle_Changed" Unchecked="SettingsToggle_Changed" />
                            </ui:CardControl>

                            <ui:CardControl Icon="{ui:SymbolIcon PlugConnected24}" Margin="0,0,0,4">
                                <ui:CardControl.Header>
                                    <StackPanel>
                                        <TextBlock Text="{Binding TrayWithProxyTitle, Source={x:Static local:Strings.Instance}}" FontSize="13.5" FontWeight="Medium" Foreground="White" />
                                        <TextBlock Text="{Binding TrayWithProxyDesc, Source={x:Static local:Strings.Instance}}" FontSize="11.5" Foreground="#9CA3AF" />
                                    </StackPanel>
                                </ui:CardControl.Header>
                                <ui:ToggleSwitch x:Name="TglMinimizeToTrayWithProxy" IsChecked="True"
                                                 Checked="SettingsToggle_Changed" Unchecked="SettingsToggle_Changed" />
                            </ui:CardControl>

                            <ui:CardControl Icon="{ui:SymbolIcon Alert24}" Margin="0,0,0,4">
                                <ui:CardControl.Header>
                                    <StackPanel>
                                        <TextBlock Text="{Binding WarnExitTitle, Source={x:Static local:Strings.Instance}}" FontSize="13.5" FontWeight="Medium" Foreground="White" />
                                        <TextBlock Text="{Binding WarnExitDesc, Source={x:Static local:Strings.Instance}}" FontSize="11.5" Foreground="#9CA3AF" />
                                    </StackPanel>
                                </ui:CardControl.Header>
                                <ui:ToggleSwitch x:Name="TglWarnOnExit" IsChecked="False"
                                                 Checked="SettingsToggle_Changed" Unchecked="SettingsToggle_Changed" />
                            </ui:CardControl>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Grid>

        <!-- Peeling GitHub Star Corner (Bottom-Right, Gold Glow) -->
        <Canvas x:Name="GithubCornerHost"
                Grid.RowSpan="2"
                Width="140"
                Height="140"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Background="{x:Null}"
                Cursor="Hand"
                MouseEnter="GithubCorner_MouseEnter"
                MouseLeave="GithubCorner_MouseLeave"
                MouseLeftButtonDown="GithubCorner_MouseLeftButtonDown"
                MouseLeftButtonUp="GithubCorner_Click">

            <!-- Layer 1: Revealed Gold Glow Triangle (clipped dynamically via StreamGeometry) -->
            <Canvas x:Name="GithubCornerRevealLayer" Width="140" Height="140" Background="{x:Null}">
                <Path x:Name="GithubCornerRevealBg">
                    <Path.Fill>
                        <LinearGradientBrush StartPoint="0.12,0.12" EndPoint="0.95,0.95">
                            <GradientStop Color="#1C1208" Offset="0.00" />
                            <GradientStop Color="#92400E" Offset="0.46" />
                            <GradientStop Color="#D97706" Offset="0.82" />
                            <GradientStop Color="#F59E0B" Offset="1.00" />
                        </LinearGradientBrush>
                    </Path.Fill>
                </Path>

                <Ellipse x:Name="GithubCornerGlow" IsHitTestVisible="False">
                    <Ellipse.Fill>
                        <RadialGradientBrush Center="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
                            <GradientStop Color="#30FDE047" Offset="0" />
                            <GradientStop Color="#00FBBF24" Offset="1" />
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>

                <Path x:Name="GithubCornerCreaseShadow" IsHitTestVisible="False">
                    <Path.Fill>
                        <LinearGradientBrush StartPoint="0.5,0.5" EndPoint="0.62,0.62">
                            <GradientStop Color="#B8000000" Offset="0" />
                            <GradientStop Color="#00000000" Offset="1" />
                        </LinearGradientBrush>
                    </Path.Fill>
                </Path>

                <!-- Diagonal CTA Text -->
                <Grid x:Name="GithubCornerCta"
                      Canvas.Left="13"
                      Canvas.Top="76"
                      Width="150"
                      Height="24"
                      Opacity="0"
                      IsHitTestVisible="False"
                      RenderTransformOrigin="0.5,0.5">
                    <Grid.RenderTransform>
                        <RotateTransform Angle="-45" />
                    </Grid.RenderTransform>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="★" FontSize="11.2" FontWeight="SemiBold" Foreground="#FDE047"
                                   Margin="0,0,3.5,0" VerticalAlignment="Center">
                            <TextBlock.Effect>
                                <DropShadowEffect Color="Black" BlurRadius="3" ShadowDepth="1" Direction="270" Opacity="0.55" />
                            </TextBlock.Effect>
                        </TextBlock>
                        <TextBlock Text="{Binding GithubStarText, Source={x:Static local:Strings.Instance}}"
                                   FontSize="10.8" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center">
                            <TextBlock.Effect>
                                <DropShadowEffect Color="Black" BlurRadius="3" ShadowDepth="1" Direction="270" Opacity="0.55" />
                            </TextBlock.Effect>
                        </TextBlock>
                    </StackPanel>
                </Grid>

                <!-- GitHub Octocat Icon -->
                <Path x:Name="GithubCornerOcto"
                      Width="24"
                      Height="24"
                      Canvas.Left="0"
                      Canvas.Top="0"
                      Fill="White"
                      IsHitTestVisible="False"
                      Data="M12,0.3 C5.37,0.3 0,5.67 0,12.3 C0,17.6 3.44,22.1 8.21,23.69 C8.81,23.8 9.03,23.43 9.03,23.11 C9.03,22.82 9.02,22.06 9.01,21.05 C5.67,21.78 4.97,19.44 4.97,19.44 C4.42,18.05 3.64,17.68 3.64,17.68 C2.55,16.94 3.72,16.95 3.72,16.95 C4.92,17.04 5.56,18.19 5.56,18.19 C6.63,20.02 8.37,19.49 9.05,19.19 C9.16,18.41 9.47,17.89 9.81,17.59 C7.15,17.29 4.34,16.26 4.34,11.66 C4.34,10.35 4.81,9.28 5.58,8.44 C5.46,8.14 5.04,6.92 5.7,5.26 C5.7,5.26 6.71,4.94 9,6.49 C9.96,6.22 10.98,6.09 12,6.09 C13.02,6.09 14.04,6.22 15,6.49 C17.29,4.94 18.3,5.26 18.3,5.26 C18.96,6.92 18.54,8.14 18.42,8.44 C19.19,9.28 19.66,10.35 19.66,11.66 C19.66,16.27 16.85,17.28 14.18,17.58 C14.61,17.95 14.99,18.68 14.99,19.8 C14.99,21.41 14.98,22.7 14.98,23.09 C14.98,23.41 15.2,23.79 15.8,23.67 C20.57,22.1 24,17.6 24,12.3 C24,5.67 18.63,0.3 12,0.3 Z">
                    <Path.Effect>
                        <DropShadowEffect Color="Black" BlurRadius="4" ShadowDepth="1" Direction="270" Opacity="0.45" />
                    </Path.Effect>
                    <Path.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform x:Name="GithubCornerOctoScale" CenterX="12" CenterY="12" ScaleX="0.77" ScaleY="0.77" />
                            <RotateTransform x:Name="GithubCornerOctoRotate" CenterX="12" CenterY="12" Angle="0" />
                            <TranslateTransform x:Name="GithubCornerOctoTranslate" X="111" Y="111" />
                        </TransformGroup>
                    </Path.RenderTransform>
                </Path>

                <!-- Subtle Golden Star Glint -->
                <Path x:Name="GithubCornerStarGlint"
                      Canvas.Left="126"
                      Canvas.Top="100"
                      Opacity="0"
                      IsHitTestVisible="False"
                      Fill="#FDE047"
                      Data="M 0,-4.8 L 1.3,-1.4 L 4.8,-1.4 L 2.0,0.7 L 3.0,4.2 L 0,2.1 L -3.0,4.2 L -2.0,0.7 L -4.8,-1.4 L -1.3,-1.4 Z" />
            </Canvas>

            <!-- Layer 2: Curled Dark Mica Page Flap -->
            <Path x:Name="GithubCornerFlapPath"
                  Stroke="#2AFFFFFF"
                  StrokeThickness="0.8"
                  StrokeLineJoin="Round">
                <Path.Fill>
                    <LinearGradientBrush StartPoint="0.10,0.10" EndPoint="0.65,0.65">
                        <GradientStop Color="#262A31" Offset="0.00" />
                        <GradientStop Color="#424956" Offset="0.42" />
                        <GradientStop Color="#21252B" Offset="0.78" />
                        <GradientStop Color="#14161A" Offset="1.00" />
                    </LinearGradientBrush>
                </Path.Fill>
                <Path.Effect>
                    <DropShadowEffect Color="Black" BlurRadius="12" ShadowDepth="4" Direction="135" Opacity="0.55" />
                </Path.Effect>
            </Path>
        </Canvas>

        <!-- Exit Warning Modal Dialog -->
        <Grid x:Name="ExitWarningOverlay"
              Grid.RowSpan="2"
              Background="#AA000000"
              Visibility="Collapsed">
            <Border Background="#202020"
                    BorderBrush="#383838"
                    BorderThickness="1"
                    CornerRadius="10"
                    Width="440"
                    Padding="22"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="{Binding ExitModalTitle, Source={x:Static local:Strings.Instance}}"
                               FontSize="16" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,8" />
                    <TextBlock Text="{Binding ExitModalBody, Source={x:Static local:Strings.Instance}}"
                               FontSize="13" Foreground="#D1D5DB" TextWrapping="Wrap" Margin="0,0,0,14" />
                    <CheckBox x:Name="ChkRememberExitChoice"
                              Content="{Binding ExitRemember, Source={x:Static local:Strings.Instance}}"
                              Foreground="#E5E7EB"
                              Margin="0,0,0,18" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <ui:Button Content="{Binding BtnCancel, Source={x:Static local:Strings.Instance}}" Appearance="Transparent" Margin="0,0,8,0"
                                   Click="BtnExitCancel_Click" />
                        <ui:Button Content="{Binding BtnExitAndStop, Source={x:Static local:Strings.Instance}}" Appearance="Danger" Margin="0,0,8,0"
                                   Click="BtnExitConfirm_Click" />
                        <ui:Button Content="{Binding BtnMinimizeTray, Source={x:Static local:Strings.Instance}}" Appearance="Primary"
                                   Click="BtnExitMinimize_Click" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</ui:FluentWindow>
