<ui:FluentWindow x:Class="WarpscoutGui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:local="clr-namespace:WarpscoutGui"
        Title="Warpscout"
        Icon="pack://application:,,,/Assets/app.png"
        Width="1120"
        Height="740"
        MinWidth="980"
        MinHeight="620"
        FontFamily="{StaticResource AppUiFont}"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        WindowStartupLocation="CenterScreen"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica"
        WindowCornerPreference="Round">

    <Grid x:Name="RootGrid">
        <Grid.Resources>
            <!-- Windows 11 NavigationView / Settings sidebar button style -->
            <Style x:Key="SidebarNavButtonStyle" TargetType="Button">
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="4"
                                    SnapsToDevicePixels="True">
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                  Margin="{TemplateBinding Padding}" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.4" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="SectionHeaderTextStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="13" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                <Setter Property="Margin" Value="0,24,0,8" />
            </Style>

            <Style x:Key="CardTitleTextStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="14" />
                <Setter Property="FontWeight" Value="Normal" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            </Style>

            <Style x:Key="CardDescTextStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontWeight" Value="Normal" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                <Setter Property="Margin" Value="0,2,0,0" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="44" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Row 0: Hamburger outside ui:TitleBar bounds (Wpf.Ui 3.0.5 TitleBar WndProc marks its full rect HTCAPTION) -->
        <Grid Grid.Row="0" Height="44">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Button x:Name="BtnToggleSidebar"
                    Grid.Column="0"
                    Style="{StaticResource SidebarNavButtonStyle}"
                    Width="40" Height="32"
                    Margin="12,0,0,0"
                    VerticalAlignment="Center"
                    ToolTip="{Binding TooltipToggleSidebar, Source={x:Static local:Strings.Instance}}"
                    Click="BtnToggleSidebar_Click">
                <ui:SymbolIcon Symbol="Navigation20" FontSize="16"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Button>

            <ui:TitleBar x:Name="AppTitleBar"
                         Grid.Column="1"
                         Height="44" />

            <TextBlock Grid.Column="1"
                       Panel.ZIndex="2"
                       Text="Warpscout"
                       FontSize="12"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       Margin="10,0,0,0"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Center"
                       IsHitTestVisible="False" />
        </Grid>

        <!-- Two-Column Windows 11 Settings / MagicPods Layout -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SidebarCol" Width="244" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Left Navigation Pane -->
            <Grid x:Name="SidebarNavPanel" Grid.Column="0" Margin="8,0,0,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- App Identity + Clickable Core Version Status (like User Account in Windows 11 Settings) -->
                <Grid Grid.Row="0" Margin="6,4,6,16" MinHeight="40">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Image Source="pack://application:,,,/Assets/app.png"
                           Width="36" Height="36"
                           VerticalAlignment="Center"
                           RenderOptions.BitmapScalingMode="HighQuality">
                        <Image.Clip>
                            <EllipseGeometry Center="18,18" RadiusX="18" RadiusY="18" />
                        </Image.Clip>
                    </Image>
                    <StackPanel x:Name="SidebarBrandText" Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0">
                        <TextBlock Text="Warpscout" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        <Button Style="{StaticResource SidebarNavButtonStyle}"
                                Padding="4,2" Margin="-4,1,0,0"
                                ToolTip="{Binding TooltipCoreSettings, Source={x:Static local:Strings.Instance}}"
                                Click="BtnVersionStatus_Click">
                            <Grid VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Ellipse x:Name="StatusDot" Grid.Column="0" Width="6" Height="6"
                                         Fill="{DynamicResource SystemFillColorCautionBrush}"
                                         Margin="0,0,6,0" VerticalAlignment="Center" />
                                <TextBlock x:Name="TxtStatusPill" Grid.Column="1"
                                           Text="{Binding StatusChecking, Source={x:Static local:Strings.Instance}}"
                                           FontSize="12"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           TextTrimming="CharacterEllipsis" />
                            </Grid>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- Top Navigation Items -->
                <StackPanel Grid.Row="1">
                    <!-- Nav: Scanner -->
                    <Button x:Name="NavScanner" Tag="scanner" Click="NavButton_Click"
                            Style="{StaticResource SidebarNavButtonStyle}"
                            Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                            Height="38" Margin="0,0,0,3"
                            ToolTip="{Binding NavScanner, Source={x:Static local:Strings.Instance}}">
                        <Grid>
                            <Border x:Name="IndScanner" Width="3" Height="16" CornerRadius="2"
                                    Background="{DynamicResource SystemAccentBrush}"
                                    HorizontalAlignment="Left" VerticalAlignment="Center" />
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="13,0,12,0">
                                <Image Source="{StaticResource FluentScannerColorIcon}" Width="22" Height="22"
                                       RenderOptions.BitmapScalingMode="HighQuality" />
                                <TextBlock x:Name="TxtNavScanner"
                                           Text="{Binding NavScanner, Source={x:Static local:Strings.Instance}}"
                                           FontSize="14" FontWeight="Normal"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                           VerticalAlignment="Center" Margin="12,0,0,0" />
                            </StackPanel>
                        </Grid>
                    </Button>

                    <!-- Nav: Advanced Scanner -->
                    <Button x:Name="NavAdvanced" Tag="advanced" Click="NavButton_Click"
                            Style="{StaticResource SidebarNavButtonStyle}"
                            Height="38" Margin="0,0,0,3"
                            ToolTip="{Binding NavAdvanced, Source={x:Static local:Strings.Instance}}">
                        <Grid>
                            <Border x:Name="IndAdvanced" Width="3" Height="16" CornerRadius="2"
                                    Background="Transparent"
                                    HorizontalAlignment="Left" VerticalAlignment="Center" />
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="13,0,12,0">
                                <Image Source="{StaticResource FluentAdvancedColorIcon}" Width="22" Height="22"
                                       RenderOptions.BitmapScalingMode="HighQuality" />
                                <TextBlock x:Name="TxtNavAdvanced"
                                           Text="{Binding NavAdvanced, Source={x:Static local:Strings.Instance}}"
                                           FontSize="14" FontWeight="Normal"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                           VerticalAlignment="Center" Margin="12,0,0,0" />
                            </StackPanel>
                        </Grid>
                    </Button>

                    <!-- Nav: Servers -->
                    <Button x:Name="NavServers" Tag="servers" Click="NavButton_Click"
                            Style="{StaticResource SidebarNavButtonStyle}"
                            Height="38" Margin="0,0,0,3"
                            ToolTip="{Binding NavServers, Source={x:Static local:Strings.Instance}}">
                        <Grid>
                            <Border x:Name="IndServers" Width="3" Height="16" CornerRadius="2"
                                    Background="Transparent"
                                    HorizontalAlignment="Left" VerticalAlignment="Center" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="13,0,8,0">
                                    <Image Source="{StaticResource FluentServersColorIcon}" Width="22" Height="22"
                                           RenderOptions.BitmapScalingMode="HighQuality" />
                                    <TextBlock x:Name="TxtNavServers"
                                               Text="{Binding NavServers, Source={x:Static local:Strings.Instance}}"
                                               FontSize="14" FontWeight="Normal"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                               VerticalAlignment="Center" Margin="12,0,0,0" />
                                </StackPanel>
                                <Border x:Name="NavServersBadge" Grid.Column="1" Visibility="Collapsed"
                                        Background="{DynamicResource ControlFillColorDefaultBrush}"
                                        CornerRadius="10" Padding="7,1" Margin="0,0,10,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="TxtNavServersBadge" Text="0" FontSize="12"
                                               FontFamily="{StaticResource AppMonoFont}"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </Border>
                            </Grid>
                        </Grid>
                    </Button>
                </StackPanel>

                <!-- Bottom Footer: GitHub Star Item + Divider + Pinned Settings -->
                <StackPanel Grid.Row="2">
                    <Button Click="BtnGithubStar_Click"
                            Style="{StaticResource SidebarNavButtonStyle}"
                            MinHeight="38"
                            Padding="0,7"
                            ToolTip="{Binding GithubStarText, Source={x:Static local:Strings.Instance}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid Grid.Column="0" Width="22" Height="22" Margin="13,0,0,0" VerticalAlignment="Center">
                                <Image Source="{StaticResource GithubOctocatIcon}" Width="20" Height="20"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       RenderOptions.BitmapScalingMode="HighQuality" />
                                <Image x:Name="SidebarGithubCollapsedStar"
                                       Source="{StaticResource FluentStarColorIcon}"
                                       Width="10" Height="10"
                                       HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                       Margin="0,0,-2,-2"
                                       Visibility="Collapsed"
                                       RenderOptions.BitmapScalingMode="HighQuality" />
                            </Grid>
                            <StackPanel x:Name="SidebarGithubText" Grid.Column="1" VerticalAlignment="Center" Margin="12,0,6,0">
                                <TextBlock Text="GitHub" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                <Grid VerticalAlignment="Center" Margin="0,1,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Image Grid.Column="0" Source="{StaticResource FluentStarColorIcon}" Width="12" Height="12"
                                           Margin="0,0,4,0" VerticalAlignment="Center"
                                           RenderOptions.BitmapScalingMode="HighQuality" />
                                    <TextBlock Grid.Column="1" Text="{Binding GithubStarText, Source={x:Static local:Strings.Instance}}"
                                               FontSize="12"
                                               Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                               TextTrimming="CharacterEllipsis" />
                                </Grid>
                            </StackPanel>
                            <ui:SymbolIcon x:Name="SidebarGithubExternalIcon"
                                           Grid.Column="2"
                                           Symbol="Open16" FontSize="12"
                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                           Margin="0,0,12,0"
                                           VerticalAlignment="Center" />
                        </Grid>
                    </Button>

                    <Border Height="1"
                            Background="{DynamicResource DividerStrokeColorDefaultBrush}"
                            Margin="8,6,8,6" />

                    <Button x:Name="NavSettings" Tag="settings" Click="NavButton_Click"
                            Style="{StaticResource SidebarNavButtonStyle}"
                            Height="38"
                            ToolTip="{Binding NavSettings, Source={x:Static local:Strings.Instance}}">
                        <Grid>
                            <Border x:Name="IndSettings" Width="3" Height="16" CornerRadius="2"
                                    Background="Transparent"
                                    HorizontalAlignment="Left" VerticalAlignment="Center" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="13,0,8,0">
                                    <Image Source="{StaticResource FluentSettingsColorIcon}" Width="22" Height="22"
                                           RenderOptions.BitmapScalingMode="HighQuality" />
                                    <TextBlock x:Name="TxtNavSettings"
                                               Text="{Binding NavSettings, Source={x:Static local:Strings.Instance}}"
                                               FontSize="14" FontWeight="Normal"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                               VerticalAlignment="Center" Margin="12,0,0,0" />
                                </StackPanel>
                                <Ellipse x:Name="NavSettingsUpdateDot" Grid.Column="1" Width="7" Height="7"
                                         Fill="{DynamicResource SystemAccentBrush}"
                                         Visibility="Collapsed" Margin="0,0,12,0" VerticalAlignment="Center" />
                            </Grid>
                        </Grid>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Right Content Area -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Global Top Banners (fluid up to 1000px, centered on wide windows) -->
                <Grid Grid.Row="0" Margin="36,12,36,0">
                    <StackPanel MaxWidth="1000" HorizontalAlignment="Stretch">
                        <!-- Explicit Core Download Progress Banner -->
                        <Border x:Name="CoreDownloadPanel"
                                Visibility="Collapsed"
                                Background="{DynamicResource SystemFillColorAttentionBackgroundBrush}"
                                BorderBrush="{DynamicResource CardBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="14,10"
                                Margin="0,0,0,8">
                            <StackPanel>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <ui:SymbolIcon Symbol="ArrowDownload20" FontSize="16"
                                                       Margin="0,0,8,0"
                                                       Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                        <TextBlock Text="{Binding CoreDownloadTitle, Source={x:Static local:Strings.Instance}}"
                                                   FontWeight="SemiBold" FontSize="13"
                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding CoreDownloadLockNote, Source={x:Static local:Strings.Instance}}"
                                               FontSize="12"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                               VerticalAlignment="Center" />
                                </Grid>
                                <TextBlock x:Name="TxtCoreDownloadStatus"
                                           Text="{Binding CoreDownloadConnecting, Source={x:Static local:Strings.Instance}}"
                                           FontSize="12"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                           Margin="0,0,0,6" />
                                <ProgressBar x:Name="PbCoreDownload" Height="4" Minimum="0" Maximum="100" Value="0" />
                            </StackPanel>
                        </Border>

                        <!-- Explicit Core Error / Info Notification Banner -->
                        <Border x:Name="CoreNoticePanel"
                                Visibility="Collapsed"
                                CornerRadius="4"
                                Padding="14,10"
                                Margin="0,0,0,8"
                                BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                    <TextBlock x:Name="TxtCoreNoticeTitle" FontWeight="SemiBold" FontSize="13"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                    <TextBlock x:Name="TxtCoreNoticeMessage" FontSize="12"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                               TextWrapping="Wrap" Margin="0,2,0,0" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <ui:Button x:Name="BtnRetryDownload"
                                               Content="{Binding BtnRetry, Source={x:Static local:Strings.Instance}}"
                                               Appearance="Secondary" Height="30" FontSize="12"
                                               Margin="0,0,6,0" Click="BtnUpdateCore_Click" />
                                    <ui:Button x:Name="BtnPickCoreFromError"
                                               Content="{Binding BtnBrowse, Source={x:Static local:Strings.Instance}}"
                                               Appearance="Secondary" Height="30" FontSize="12"
                                               Margin="0,0,6,0" Click="BtnBrowseCore_Click" />
                                    <ui:Button Content="{Binding BtnHide, Source={x:Static local:Strings.Instance}}"
                                               Appearance="Transparent" Height="30" FontSize="12"
                                               Click="BtnDismissCoreNotice_Click" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Active SOCKS5 Proxy Banner -->
                        <Border x:Name="SocksBanner"
                                Visibility="Collapsed"
                                Background="{DynamicResource SystemFillColorSuccessBackgroundBrush}"
                                BorderBrush="{DynamicResource CardBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="14,8"
                                Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Ellipse Width="7" Height="7"
                                             Fill="{DynamicResource SystemFillColorSuccessBrush}"
                                             Margin="0,0,10,0" VerticalAlignment="Center" />
                                    <TextBlock x:Name="TxtSocksBanner"
                                               VerticalAlignment="Center"
                                               FontSize="13"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                               Text="SOCKS5: 127.0.0.1:1080" />
                                </StackPanel>
                                <ui:Button x:Name="BtnStopSocks"
                                           Grid.Column="1"
                                           Content="{Binding BtnStopSocks, Source={x:Static local:Strings.Instance}}"
                                           Icon="{ui:SymbolIcon Stop16}"
                                           Appearance="Secondary"
                                           Height="28" Padding="12,0" FontSize="12"
                                           Click="BtnStopSocks_Click" />
                            </Grid>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- Pages Host -->
                <Grid x:Name="MainWorkspace" Grid.Row="1">

                    <!-- ==================== PAGE 1: SCANNER & ADVANCED ==================== -->
                    <ScrollViewer x:Name="PageScanner" VerticalScrollBarVisibility="Auto">
                        <Grid Margin="36,12,36,36">
                            <StackPanel MaxWidth="1000" HorizontalAlignment="Stretch">
                                <!-- Page Header -->
                                <TextBlock x:Name="TxtScannerPageTitle"
                                           Text="{Binding ScannerTitle, Source={x:Static local:Strings.Instance}}"
                                           FontFamily="{StaticResource AppDisplayFont}"
                                           FontSize="28" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                           Margin="0,0,0,20" />

                                <!-- GUI Update Notification Banner -->
                                <Border x:Name="GuiUpdateBanner"
                                        Visibility="Collapsed"
                                        Background="{DynamicResource SystemFillColorAttentionBackgroundBrush}"
                                        BorderBrush="{DynamicResource CardBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        Padding="14,10"
                                        Margin="0,0,0,8"
                                        Cursor="Hand"
                                        MouseLeftButtonUp="GuiUpdateBanner_Click">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <ui:SymbolIcon Symbol="ArrowDownload20" FontSize="18"
                                                       Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                                       VerticalAlignment="Center" Margin="0,0,12,0" />
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,10,0">
                                            <TextBlock x:Name="TxtGuiBannerTitle" FontSize="13" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                            <TextBlock x:Name="TxtGuiBannerSub" FontSize="12"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                       Margin="0,2,0,0" />
                                        </StackPanel>
                                        <ui:Button Grid.Column="2" Icon="{ui:SymbolIcon Dismiss16}" Appearance="Transparent"
                                                   Width="28" Height="28" Padding="0"
                                                   VerticalAlignment="Center" Click="BtnDismissGuiBanner_Click" />
                                    </Grid>
                                </Border>

                                <!-- Hero Card -->
                                <Border Background="{DynamicResource CardBackground}"
                                        BorderBrush="{DynamicResource CardBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        Padding="16,14"
                                        Margin="0,0,0,8">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <Border Width="40" Height="40" CornerRadius="6"
                                                    Background="{DynamicResource ControlFillColorDefaultBrush}"
                                                    Margin="0,0,14,0" VerticalAlignment="Center">
                                                <ui:SymbolIcon Symbol="ShieldGlobe24" FontSize="20"
                                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                            </Border>

                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,14,0">
                                                <TextBlock x:Name="TxtHeroTitle"
                                                           Text="{Binding HeroReady, Source={x:Static local:Strings.Instance}}"
                                                           FontSize="14" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                                <TextBlock x:Name="TxtHeroSubtitle"
                                                           Text=""
                                                           Style="{StaticResource CardDescTextStyle}"
                                                           TextTrimming="CharacterEllipsis"
                                                           TextWrapping="NoWrap" />
                                            </StackPanel>

                                            <ui:Button x:Name="BtnScan"
                                                       Grid.Column="2"
                                                       Content="{Binding BtnFindServers, Source={x:Static local:Strings.Instance}}"
                                                       Icon="{ui:SymbolIcon Play16}"
                                                       Appearance="Primary"
                                                       Height="32" Padding="14,0"
                                                       FontSize="13" FontWeight="Normal"
                                                       Click="BtnScan_Click" />
                                        </Grid>

                                        <!-- Embedded Scan Progress Section -->
                                        <StackPanel x:Name="ScanProgressCard" Visibility="Collapsed" Margin="0,12,0,0">
                                            <Border BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                                                    BorderThickness="0,1,0,0" Padding="0,12,0,0">
                                                <StackPanel>
                                                    <Grid Margin="0,0,0,6">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock x:Name="TxtScanPhase"
                                                                   Text="{Binding ScanPreparing, Source={x:Static local:Strings.Instance}}"
                                                                   FontSize="12"
                                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                                   VerticalAlignment="Center" />
                                                        <TextBlock x:Name="TxtScanCount" Grid.Column="1" Text=""
                                                                   FontSize="12" FontFamily="{StaticResource AppMonoFont}"
                                                                   Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                                                   VerticalAlignment="Center" Margin="12,0,10,0" />
                                                        <ui:Button x:Name="BtnToggleScanLogs" Grid.Column="2"
                                                                   Content="{Binding BtnShowLog, Source={x:Static local:Strings.Instance}}"
                                                                   Appearance="Secondary"
                                                                   Height="28" Padding="10,0" FontSize="12"
                                                                   Click="BtnToggleScanLogs_Click" />
                                                    </Grid>
                                                    <ProgressBar x:Name="PbScan" Height="4" Minimum="0" Maximum="100" Value="0" />
                                                    <Border x:Name="ScanLogsPanel" Visibility="Collapsed"
                                                            Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
                                                            BorderBrush="{DynamicResource CardBorderBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="4" Padding="2" Margin="0,8,0,0">
                                                        <TextBox x:Name="TxtScanLogs"
                                                                 IsReadOnly="True"
                                                                 AcceptsReturn="True"
                                                                 TextWrapping="NoWrap"
                                                                 VerticalScrollBarVisibility="Auto"
                                                                 HorizontalScrollBarVisibility="Auto"
                                                                 Height="160"
                                                                 Background="Transparent"
                                                                 Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                                 BorderThickness="0"
                                                                 FontFamily="{StaticResource AppMonoFont}"
                                                                 FontSize="12"
                                                                 Padding="8,6" />
                                                    </Border>
                                                    <Border x:Name="ScanErrorBox" Visibility="Collapsed"
                                                            Background="{DynamicResource SystemFillColorCriticalBackgroundBrush}"
                                                            BorderBrush="{DynamicResource CardBorderBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="4" Padding="10,8" Margin="0,8,0,0">
                                                        <TextBlock x:Name="TxtScanError"
                                                                   Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                                                                   FontSize="12" TextWrapping="Wrap" />
                                                    </Border>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <!-- Best Server Quick Action Card (neutral surface, secondary buttons) -->
                                <Border x:Name="BestServerCard"
                                        Visibility="Collapsed"
                                        Background="{DynamicResource CardBackground}"
                                        BorderBrush="{DynamicResource CardBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        Padding="16,12"
                                        Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                            <Grid VerticalAlignment="Center">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Ellipse Grid.Column="0" Width="7" Height="7"
                                                         Fill="{DynamicResource SystemFillColorSuccessBrush}"
                                                         Margin="0,0,8,0" VerticalAlignment="Center" />
                                                <TextBlock x:Name="TxtBestTitle" Grid.Column="1" Text=""
                                                           Style="{StaticResource CardTitleTextStyle}"
                                                           TextTrimming="CharacterEllipsis" />
                                            </Grid>
                                            <TextBlock x:Name="TxtBestSubtitle" Text="—"
                                                       FontFamily="{StaticResource AppMonoFont}"
                                                       Style="{StaticResource CardDescTextStyle}"
                                                       TextTrimming="CharacterEllipsis"
                                                       TextWrapping="NoWrap"
                                                       Margin="15,2,0,0" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <ui:Button x:Name="BtnBestDownload"
                                                       Content="{Binding BtnBestDownload, Source={x:Static local:Strings.Instance}}"
                                                       Icon="{ui:SymbolIcon ArrowDownload16}"
                                                       Appearance="Secondary"
                                                       Height="32" Padding="12,0" FontSize="13"
                                                       Margin="0,0,6,0"
                                                       Click="BtnBestDownload_Click" />
                                            <ui:Button x:Name="BtnBestProxy"
                                                       Content="{Binding BtnProxyStart, Source={x:Static local:Strings.Instance}}"
                                                       Icon="{ui:SymbolIcon PlugConnected24, FontSize=14}"
                                                       Appearance="Secondary"
                                                       Height="32" Padding="12,0" FontSize="13"
                                                       Margin="0,0,6,0"
                                                       Click="BtnBestProxy_Click" />
                                            <ui:Button Content="{Binding BtnAllServers, Source={x:Static local:Strings.Instance}}"
                                                       Icon="{ui:SymbolIcon ArrowRight16}"
                                                       Appearance="Transparent"
                                                       Height="32" Padding="10,0" FontSize="13"
                                                       Click="BtnGoToServers_Click" />
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- Standard Scan Parameters -->
                                <StackPanel x:Name="ScanOptionsCards">
                                    <TextBlock Text="{Binding ScanParamsHeader, Source={x:Static local:Strings.Instance}}"
                                               Style="{StaticResource SectionHeaderTextStyle}" />

                                    <!-- Protocol -->
                                    <ui:CardControl Icon="{ui:SymbolIcon ShieldGlobe24, FontSize=18}" Margin="0,0,0,3">
                                        <ui:CardControl.Header>
                                            <StackPanel>
                                                <TextBlock Text="{Binding ProtoTitle, Source={x:Static local:Strings.Instance}}" Style="{StaticResource CardTitleTextStyle}" />
                                                <TextBlock Text="{Binding ProtoDesc, Source={x:Static local:Strings.Instance}}" Style="{StaticResource CardDescTextStyle}" />
                                            </StackPanel>
                                        </ui:CardControl.Header>
                                        <ComboBox x:Name="CmbProto" Width="184" SelectedIndex="0" FontSize="13"
                                                  SelectionChanged="CmbProto_SelectionChanged">
                                            <ComboBoxItem Tag="awg" Content="AmneziaWG" />
                                            <ComboBoxItem Tag="awg31" Content="AmneziaWG 3.1" />
                                            <ComboBoxItem Tag="wg" Content="WireGuard" />
                                            <ComboBoxItem Tag="masque" Content="MASQUE (QUIC)" />
                                            <ComboBoxItem Tag="masque-h2" Content="MASQUE H2 (TCP)" />
                                        </ComboBox>
                                    </ui:CardControl>

                                    <!-- AmneziaWG 3.1 Parameters (MagicPods-style clean borderless rows inside expander) -->
                                    <ui:CardExpander x:Name="CardAwg31"
                                                     Icon="{ui:SymbolIcon Options24, FontSize=18}"
                                                     Visibility="Collapsed"
                                                     IsExpanded="True"
                                                     ContentPadding="48,14,16,14"
                                                     Margin="0,0,0,3">
                                        <ui:CardExpander.Header>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Awg31CardTitle, Source={x:Static local:Strings.Instance}}"
                                                           Style="{StaticResource CardTitleTextStyle}" />
                                                <TextBlock x:Name="TxtAwg31CardDesc"
                                                           Text="{Binding Awg31CardDefaultDesc, Source={x:Static local:Strings.Instance}}"
                                                           Style="{StaticResource CardDescTextStyle}" />
                                            </StackPanel>
                                        </ui:CardExpander.Header>
                                        <StackPanel>
                                            <!-- Padding -->
                                            <Grid Margin="0,0,0,14">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                                    <TextBlock Text="{Binding Awg31PaddingTitle, Source={x:Static local:Strings.Instance}}"
                                                               Style="{StaticResource CardTitleTextStyle}" />
                                                    <TextBlock Text="{Binding Awg31PaddingDesc, Source={x:Static local:Strings.Instance}}"
                                                               Style="{StaticResource CardDescTextStyle}" />
                                                </StackPanel>
                                                <ui:TextBox x:Name="TxtAwg31Padding"
                                                            Grid.Column="1"
                                                            Width="120"
                                                            PlaceholderText="{Binding Awg31PaddingPlaceholder, Source={x:Static local:Strings.Instance}}"
                                                            FontFamily="{StaticResource AppMonoFont}"
                                                            VerticalAlignment="Center"
                                                            TextChanged="Awg31Option_TextChanged"
                                                            LostFocus="Awg31Option_LostFocus" />
                                            </Grid>

                                            <!-- Random Trailers -->
                                            <Grid Margin="0,0,0,14">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                                    <TextBlock Text="{Binding Awg31RandomTrailersTitle, Source={x:Static local:Strings.Instance}}"
                                                               Style="{StaticResource CardTitleTextStyle}" />
                                                    <TextBlock Text="{Binding Awg31RandomTrailersDesc, Source={x:Static local:Strings.Instance}}"
                                                               Style="{StaticResource CardDescTextStyle}" />
                                                </StackPanel>
                                                <ui:ToggleSwitch x:Name="ChkAwg31RandomTrailers"
                                                                 Grid.Column="1"
                                                                 IsChecked="False"
                                                                 VerticalAlignment="Center"
                                                                 Checked="Awg31Option_ToggleChanged"
                                                                 Unchecked="Awg31Option_ToggleChanged" />
                                            </Grid>

                                            <!-- Disable Cookies -->
                                            <Grid Margin="0,0,0,14">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                                    <TextBlock Text="{Binding Awg31DisableCookiesTitle, Source={x:Static local:Strings.Instance}}"
                                                               Style="{StaticResource CardTitleTextStyle}" />
                                                    <TextBlock Text="{Binding Awg31DisableCookiesDesc, Source={x:Static local:Strings.Instance}}"
                                                               Style="{StaticResource CardDescTextStyle}" />
                                                </StackPanel>
                                                <ui:ToggleSwitch x:Name="ChkAwg31DisableCookies"
                                                                 Grid.Column="1"
                                                                 IsChecked="False"
                                                                 VerticalAlignment="Center"
                                                                 Checked="Awg31Option_ToggleChanged"
                                                                 Unchecked="Awg31Option_ToggleChanged" />
                                            </Grid>

                                            <Border BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                                                    BorderThickness="0,1,0,0" Margin="0,0,0,12" />

                                            <TextBlock Text="{Binding Awg31TimingsHeader, Source={x:Static local:Strings.Instance}}"
                                                       FontSize="12" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                       Margin="0,0,0,10" />

                                            <Grid Margin="0,0,0,10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Awg31RekeyAfterLabel, Source={x:Static local:Strings.Instance}}"
                                                           Style="{StaticResource CardTitleTextStyle}"
                                                           VerticalAlignment="Center" Margin="0,0,16,0" />
                                                <ui:TextBox x:Name="TxtAwg31RekeyAfter"
                                                            Grid.Column="1" Width="120"
                                                            PlaceholderText="{Binding Awg31RekeyAfterPlaceholder, Source={x:Static local:Strings.Instance}}"
                                                            FontFamily="{StaticResource AppMonoFont}"
                                                            TextChanged="Awg31Option_TextChanged"
                                                            LostFocus="Awg31Option_LostFocus" />
                                            </Grid>

                                            <Grid Margin="0,0,0,10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Awg31RejectAfterLabel, Source={x:Static local:Strings.Instance}}"
                                                           Style="{StaticResource CardTitleTextStyle}"
                                                           VerticalAlignment="Center" Margin="0,0,16,0" />
                                                <ui:TextBox x:Name="TxtAwg31RejectAfter"
                                                            Grid.Column="1" Width="120"
                                                            PlaceholderText="{Binding Awg31RejectAfterPlaceholder, Source={x:Static local:Strings.Instance}}"
                                                            FontFamily="{StaticResource AppMonoFont}"
                                                            ToolTip="{Binding Awg31RejectAfterTooltip, Source={x:Static local:Strings.Instance}}"
                                                            TextChanged="Awg31Option_TextChanged"
                                                            LostFocus="Awg31Option_LostFocus" />
                                            </Grid>

                                            <Grid Margin="0,0,0,10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Awg31RekeyTimeoutLabel, Source={x:Static local:Strings.Instance}}"
                                                           Style="{StaticResource CardTitleTextStyle}"
                                                           VerticalAlignment="Center" Margin="0,0,16,0" />
                                                <ui:TextBox x:Name="TxtAwg31RekeyTimeout"
                                                            Grid.Column="1" Width="120"
                                                            PlaceholderText="{Binding Awg31RekeyTimeoutPlaceholder, Source={x:Static local:Strings.Instance}}"
                                                            FontFamily="{StaticResource AppMonoFont}"
                                                            TextChanged="Awg31Option_TextChanged"
                                                            LostFocus="Awg31Option_LostFocus" />
                                            </Grid>

                                            <Grid Margin="0,0,0,10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Awg31KeepaliveTimeoutLabel, Source={x:Static local:Strings.Instance}}"
                                                           Style="{StaticResource CardTitleTextStyle}"
                                                           VerticalAlignment="Center" Margin="0,0,16,0" />
                                                <ui:TextBox x:Name="TxtAwg31KeepaliveTimeout"
                                                            Grid.Column="1" Width="120"
                                                            PlaceholderText="{Binding Awg31KeepaliveTimeoutPlaceholder, Source={x:Static local:Strings.Instance}}"
                                                            FontFamily="{StaticResource AppMonoFont}"
                                                            TextChanged="Awg31Option_TextChanged"
                                                            LostFocus="Awg31Option_LostFocus" />
                                            </Grid>

                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Awg31MaxHandshakesLabel, Source={x:Static local:Strings.Instance}}"
                                                           Style="{StaticResource CardTitleTextStyle}"
                                                           VerticalAlignment="Center" Margin="0,0,16,0" />
                                                <ui:TextBox x:Name="TxtAwg31MaxHandshakes"
                                                            Grid.Column="1" Width="120"
                                                            PlaceholderText="{Binding Awg31MaxHandshakesPlaceholder, Source={x:Static local:Strings.Instance}}"
                                                            FontFamily="{StaticResource AppMonoFont}"
                                                            TextChanged="Awg31Option_TextChanged"
                                                            LostFocus="Awg31Option_LostFocus" />
                                            </Grid>
                                        </StackPanel>
                                    </ui:CardExpander>

                                    <!-- Exclude Node -->
                                    <ui:CardControl x:Name="CardExcludeNode"
                                                    Icon="{ui:SymbolIcon LocationOff24, FontSize=18}"
                                                    Margin="0,0,0,3"
                                                    ToolTipService.ShowOnDisabled="True">
                                        <ui:CardControl.Header>
                                            <StackPanel>
                                                <TextBlock Text="{Binding ExcludeNodeTitle, Source={x:Static local:Strings.Instance}}" Style="{StaticResource CardTitleTextStyle}" />
                                                <TextBlock Text="{Binding ExcludeNodeDesc, Source={x:Static local:Strings.Instance}}" Style="{StaticResource CardDescTextStyle}" />
                                            </StackPanel>
                                        </ui:CardControl.Header>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <ui:TextBox x:Name="TxtExcludeNode"
                                                        Width="96"
                                                        Text="DME"
                                                        PlaceholderText="{Binding ExcludeNodePlaceholder, Source={x:Static local:Strings.Instance}}"
                                                        FontFamily="{StaticResource AppMonoFont}"
                                                        Margin="0,0,12,0"
                                                        IsEnabled="{Binding IsChecked, ElementName=ChkDme}"
                                                        TextChanged="TxtExcludeNode_TextChanged"
                                                        LostFocus="TxtExcludeNode_LostFocus" />
                                            <ui:ToggleSwitch x:Name="ChkDme" IsChecked="True"
                                                             Checked="ScanOption_Changed" Unchecked="ScanOption_Changed" />
                                        </StackPanel>
                                    </ui:CardControl>

                                    <!-- Tun Ping -->
                                    <ui:CardControl Icon="{ui:SymbolIcon Pulse24, FontSize=18}" Margin="0,0,0,3">
                                        <ui:CardControl.Header>
                                            <StackPanel>
                                                <TextBlock Text="{Binding TunPingTitle, Source={x:Static local:Strings.Instance}}" Style="{StaticResource CardTitleTextStyle}" />
                                                <TextBlock Text="{Binding TunPingDesc, Source={x:Static local:Strings.Instance}}" Style="{StaticResource CardDescTextStyle}" />
                                            </StackPanel>
                                        </ui:CardControl.Header>
                                        <ui:ToggleSwitch x:Name="ChkPing" IsChecked="True"
                                                         Checked="ScanOption_Changed" Unchecked="ScanOption_Changed" />
                                    </ui:CardControl>

                                    <!-- Full Scan -->
                                    <ui:CardControl Icon="{ui:SymbolIcon Grid24, FontSize=18}" Margin="0,0,0,3">
                                        <ui:CardControl.Header>
                                            <StackPanel>
                                                <TextBlock Text="{Binding FullScanTitle, Source={x:Static local:Strings.Instance}}" Style="{StaticResource CardTitleTextStyle}" />
                                                <TextBlock Text="{Binding FullScanDesc, Source={x:Static local:Strings.Instance}}" Style="{StaticResource CardDescTextStyle}" />
                                            </StackPanel>
                                        </ui:CardControl.Header>
                                        <ui:ToggleSwitch x:Name="ChkFull" IsChecked="False"
                                                         Checked="ScanOption_Changed" Unchecked="ScanOption_Changed" />
                                    </ui:CardControl>

                                    <!-- Speed Test -->
                                    <ui:CardControl Icon="{ui:SymbolIcon TopSpeed24, FontSize=18}" Margin="0,0,0,3">
                                        <ui:CardControl.Header>
                                            <StackPanel>
                                                <TextBlock Text="{Binding SpeedTestTitle, Source={x:Static local:Strings.Instance}}" Style="{StaticResource CardTitleTextStyle}" />
                                                <TextBlock Text="{Binding SpeedTestDesc, Source={x:Static local:Strings.Instance}}" Style="{StaticResource CardDescTextStyle}" />
                                            </StackPanel>
                                        </ui:CardControl.Header>
                                        <ui:ToggleSwitch x:Name="ChkSpeed" IsChecked="False"
                                                         Checked="ScanOption_Changed" Unchecked="ScanOption_Changed" />
                                    </ui:CardControl>
                                </StackPanel>

                                <!-- Advanced Scanner Mode -->
                                <StackPanel x:Name="AdvancedOptionsCard" Visibility="Collapsed">
                                    <TextBlock Text="{Binding ScanParamsHeader, Source={x:Static local:Strings.Instance}}"
                                               Style="{StaticResource SectionHeaderTextStyle}" />
                                    <Border Background="{DynamicResource CardBackground}"
                                            BorderBrush="{DynamicResource CardBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="4"
                                            Padding="16,14">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <ui:SymbolIcon Symbol="Code24" FontSize="18"
                                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                               Margin="0,2,14,0" VerticalAlignment="Top" />
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="{Binding AdvFlagsTitle, Source={x:Static local:Strings.Instance}}"
                                                               Style="{StaticResource CardTitleTextStyle}" />
                                                    <TextBlock Text="{Binding AdvFlagsDesc, Source={x:Static local:Strings.Instance}}"
                                                               Style="{StaticResource CardDescTextStyle}" />
                                                </StackPanel>
                                            </Grid>
                                            <ui:TextBox x:Name="TxtCustomFlags"
                                                        PlaceholderText="{Binding AdvFlagsPlaceholder, Source={x:Static local:Strings.Instance}}"
                                                        FontFamily="{StaticResource AppMonoFont}"
                                                        FontSize="13"
                                                        Margin="32,0,0,8"
                                                        TextChanged="TxtCustomFlags_TextChanged"
                                                        LostFocus="TxtCustomFlags_LostFocus" />
                                            <TextBlock Text="{Binding AdvFlagsExamples, Source={x:Static local:Strings.Instance}}"
                                                       FontSize="12"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                       FontFamily="{StaticResource AppMonoFont}"
                                                       TextWrapping="Wrap"
                                                       Margin="32,0,0,0" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>

                    <!-- ==================== PAGE 2: SERVERS ==================== -->
                    <Grid x:Name="PageServers" Visibility="Collapsed" Margin="36,12,36,24">
                        <Grid MaxWidth="1000" HorizontalAlignment="Stretch">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!-- Header Row -->
                            <Grid Grid.Row="0" Margin="0,0,0,20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                    <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding ServersTitle, Source={x:Static local:Strings.Instance}}"
                                                   FontFamily="{StaticResource AppDisplayFont}"
                                                   FontSize="28" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                   Margin="0,0,12,0" />
                                        <Border x:Name="LastScanBadge"
                                                Visibility="Collapsed"
                                                Background="{DynamicResource ControlFillColorDefaultBrush}"
                                                CornerRadius="4"
                                                Padding="8,4"
                                                VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <ui:SymbolIcon Symbol="Clock16" FontSize="12"
                                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                               Margin="0,0,6,0" />
                                                <TextBlock x:Name="TxtLastScanTime" FontSize="12"
                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                           VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Border>
                                    </WrapPanel>
                                    <TextBlock x:Name="TxtServersSubtitle"
                                               Text="{Binding ServersSubtitle, Source={x:Static local:Strings.Instance}}"
                                               FontSize="12"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                               Margin="0,4,0,0" />
                                </StackPanel>

                                <ui:Button x:Name="BtnRefreshServers"
                                           Grid.Column="1"
                                           Content="{Binding BtnFindServers, Source={x:Static local:Strings.Instance}}"
                                           Icon="{ui:SymbolIcon ArrowSync16}"
                                           Appearance="Primary"
                                           Height="32" Padding="14,0" FontSize="13"
                                           VerticalAlignment="Center"
                                           Click="BtnScan_Click" />
                            </Grid>

                            <Border Grid.Row="1"
                                    VerticalAlignment="Top"
                                    Background="{DynamicResource CardBackground}"
                                    BorderBrush="{DynamicResource CardBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="4">
                                <Grid>
                                    <DataGrid x:Name="GridEndpoints"
                                              Visibility="Collapsed"
                                              AutoGenerateColumns="False"
                                              IsReadOnly="True"
                                              CanUserAddRows="False"
                                              CanUserDeleteRows="False"
                                              CanUserResizeRows="False"
                                              HeadersVisibility="Column"
                                              GridLinesVisibility="Horizontal"
                                              HorizontalScrollBarVisibility="Auto"
                                              HorizontalGridLinesBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                                              SelectionMode="Single"
                                              Background="Transparent"
                                              BorderThickness="0"
                                              RowHeight="44">
                                        <DataGrid.Resources>
                                            <Style x:Key="BaseEndpointColHeaderStyle" TargetType="DataGridColumnHeader">
                                                <Setter Property="Background" Value="Transparent" />
                                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                                <Setter Property="FontSize" Value="12" />
                                                <Setter Property="FontWeight" Value="Normal" />
                                                <Setter Property="Height" Value="36" />
                                                <Setter Property="Padding" Value="8,0" />
                                                <Setter Property="BorderBrush" Value="{DynamicResource DividerStrokeColorDefaultBrush}" />
                                                <Setter Property="BorderThickness" Value="0,0,0,1" />
                                                <Setter Property="HorizontalContentAlignment" Value="Left" />
                                                <Setter Property="VerticalContentAlignment" Value="Center" />
                                            </Style>
                                            <Style x:Key="RightEndpointColHeaderStyle" TargetType="DataGridColumnHeader"
                                                   BasedOn="{StaticResource BaseEndpointColHeaderStyle}">
                                                <Setter Property="Padding" Value="4,0,8,0" />
                                                <Setter Property="HorizontalContentAlignment" Value="Right" />
                                            </Style>
                                        </DataGrid.Resources>
                                        <DataGrid.ColumnHeaderStyle>
                                            <StaticResource ResourceKey="BaseEndpointColHeaderStyle" />
                                        </DataGrid.ColumnHeaderStyle>
                                        <DataGrid.RowStyle>
                                            <Style TargetType="DataGridRow">
                                                <Setter Property="Background" Value="Transparent" />
                                                <Setter Property="BorderThickness" Value="0" />
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </DataGrid.RowStyle>
                                        <DataGrid.CellStyle>
                                            <Style TargetType="DataGridCell">
                                                <Setter Property="Background" Value="Transparent" />
                                                <Setter Property="BorderThickness" Value="0" />
                                                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="DataGridCell">
                                                            <Border Background="Transparent" Padding="6,0" SnapsToDevicePixels="True">
                                                                <ContentPresenter VerticalAlignment="Center" />
                                                            </Border>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </DataGrid.CellStyle>
                                        <DataGrid.Columns>
                                            <DataGridTemplateColumn Header="{Binding ColLocation, Source={x:Static local:Strings.Instance}}" Width="*" MinWidth="132">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Grid Margin="2,0" VerticalAlignment="Center">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <Border Grid.Column="0"
                                                                    Background="{DynamicResource ControlFillColorDefaultBrush}"
                                                                    CornerRadius="4" Padding="5,2" Margin="0,0,6,0" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding CountryBadge}" FontSize="12"
                                                                           FontFamily="{StaticResource AppMonoFont}"
                                                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                                            </Border>
                                                            <TextBlock Grid.Column="1" Text="{Binding DisplayLocation}" FontSize="13"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                                       VerticalAlignment="Center" />
                                                            <Ellipse Grid.Column="2" Width="7" Height="7"
                                                                     Fill="{DynamicResource SystemFillColorSuccessBrush}"
                                                                     Margin="6,0,0,0" VerticalAlignment="Center">
                                                                <Ellipse.Style>
                                                                    <Style TargetType="Ellipse">
                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsBest}" Value="True">
                                                                                <Setter Property="Visibility" Value="Visible" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Ellipse.Style>
                                                            </Ellipse>
                                                        </Grid>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>

                                            <DataGridTemplateColumn Header="{Binding ColNode, Source={x:Static local:Strings.Instance}}" Width="48">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Border Background="{DynamicResource ControlFillColorDefaultBrush}"
                                                                CornerRadius="4" Padding="5,2"
                                                                HorizontalAlignment="Left" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding DisplayNode}"
                                                                       FontFamily="{StaticResource AppMonoFont}"
                                                                       FontSize="12"
                                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                        </Border>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>

                                            <DataGridTemplateColumn Header="{Binding ColEndpoint, Source={x:Static local:Strings.Instance}}" Width="188">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <ui:Button Content="{Binding Endpoint}"
                                                                   Appearance="Transparent"
                                                                   Padding="6,4" Height="28"
                                                                   FontFamily="{StaticResource AppMonoFont}"
                                                                   FontSize="12"
                                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                                   HorizontalAlignment="Left"
                                                                   Click="BtnCopyEndpoint_Click" />
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>

                                            <DataGridTemplateColumn Header="{Binding ColPing, Source={x:Static local:Strings.Instance}}" Width="56"
                                                                    HeaderStyle="{StaticResource RightEndpointColHeaderStyle}">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding DisplayPing}"
                                                                   Foreground="{Binding PingBrush}"
                                                                   FontFamily="{StaticResource AppMonoFont}"
                                                                   FontSize="12"
                                                                   HorizontalAlignment="Right"
                                                                   VerticalAlignment="Center"
                                                                   Margin="0,0,2,0" />
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>

                                            <DataGridTemplateColumn Header="{Binding ColLoss, Source={x:Static local:Strings.Instance}}" Width="60"
                                                                    HeaderStyle="{StaticResource RightEndpointColHeaderStyle}">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding DisplayLoss}"
                                                                   FontFamily="{StaticResource AppMonoFont}"
                                                                   FontSize="12"
                                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                                   HorizontalAlignment="Right"
                                                                   VerticalAlignment="Center"
                                                                   Margin="0,0,2,0" />
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>

                                            <DataGridTemplateColumn Header="{Binding ColSpeed, Source={x:Static local:Strings.Instance}}" Width="106"
                                                                    HeaderStyle="{StaticResource RightEndpointColHeaderStyle}">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding DisplaySpeed}"
                                                                   FontFamily="{StaticResource AppMonoFont}"
                                                                   FontSize="12"
                                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                                   HorizontalAlignment="Right"
                                                                   VerticalAlignment="Center"
                                                                   Margin="0,0,2,0" />
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>

                                            <DataGridTemplateColumn Header="{Binding ColActions, Source={x:Static local:Strings.Instance}}" Width="Auto" MinWidth="196">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <ui:Button Content="{Binding BtnRowConf, Source={x:Static local:Strings.Instance}}"
                                                                       Icon="{ui:SymbolIcon ArrowDownload16}"
                                                                       Appearance="Secondary"
                                                                       Height="28" Padding="8,0" FontSize="12"
                                                                       Margin="0,0,6,0"
                                                                       Tag="{Binding}"
                                                                       Click="BtnDownloadConf_Click" />
                                                            <ui:Button Content="{Binding ProxyButtonText}"
                                                                       Icon="{ui:SymbolIcon PlugConnected24, FontSize=14}"
                                                                       Appearance="Secondary"
                                                                       Height="28" Padding="8,0" FontSize="12"
                                                                       Tag="{Binding}"
                                                                       Click="BtnToggleSocks_Click">
                                                                <ui:Button.Style>
                                                                    <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsProxied}" Value="True">
                                                                                <Setter Property="Background" Value="{DynamicResource SystemFillColorSuccessBackgroundBrush}" />
                                                                                <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </ui:Button.Style>
                                                            </ui:Button>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>

                                    <StackPanel x:Name="EmptyTablePanel" Margin="0,48" VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <TextBlock x:Name="TxtEmptyTable"
                                                   Text="{Binding EmptyTableInitial, Source={x:Static local:Strings.Instance}}"
                                                   FontSize="14"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                   HorizontalAlignment="Center" Margin="0,0,0,12" />
                                        <ui:Button Content="{Binding BtnGoToScanner, Source={x:Static local:Strings.Instance}}"
                                                   Appearance="Secondary" Height="32" Padding="14,0" FontSize="13"
                                                   HorizontalAlignment="Center" Click="BtnGoToScanner_Click" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>

                    <!-- ==================== PAGE 3: SETTINGS ==================== -->
                    <ScrollViewer x:Name="PageSettings" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                        <Grid Margin="36,12,36,36">
                            <StackPanel MaxWidth="1000" HorizontalAlignment="Stretch">
                                <!-- Page Header -->
                                <TextBlock Text="{Binding SettingsTitle, Source={x:Static local:Strings.Instance}}"
                                           FontFamily="{StaticResource AppDisplayFont}"
                                           FontSize="28" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                           Margin="0,0,0,20" />

                                <!-- Section: App Updates -->
                                <TextBlock Text="{Binding GuiUpdateSectionHeader, Source={x:Static local:Strings.Instance}}"
                                           Style="{StaticResource SectionHeaderTextStyle}" Margin="0,0,0,8" />

                                <ui:CardControl Icon="{ui:SymbolIcon ArrowSync24, FontSize=18}" Margin="0,0,0,3">
                                    <ui:CardControl.Header>
                                        <StackPanel>
                                            <TextBlock x:Name="TxtGuiCurrentVersion" Style="{StaticResource CardTitleTextStyle}" />
                                            <TextBlock x:Name="TxtGuiUpdateStatus" Style="{StaticResource CardDescTextStyle}" />
                                        </StackPanel>
                                    </ui:CardControl.Header>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <ui:Button x:Name="BtnCheckGuiUpdates"
                                                   Content="{Binding BtnCheckUpdates, Source={x:Static local:Strings.Instance}}"
                                                   Appearance="Secondary" Height="32" Padding="12,0" FontSize="13"
                                                   Click="BtnCheckGuiUpdates_Click" />
                                        <ui:Button x:Name="BtnPrimaryGuiUpdate"
                                                   Visibility="Collapsed"
                                                   Icon="{ui:SymbolIcon ArrowDownload16}"
                                                   Appearance="Primary" Height="32" Padding="12,0" FontSize="13"
                                                   Margin="8,0,0,0"
                                                   Click="BtnPrimaryGuiUpdate_Click" />
                                        <ui:Button x:Name="BtnCancelGuiDownload"
                                                   Visibility="Collapsed"
                                                   Content="{Binding BtnCancel, Source={x:Static local:Strings.Instance}}"
                                                   Appearance="Secondary" Height="32" Padding="12,0" FontSize="13"
                                                   Margin="8,0,0,0"
                                                   Click="BtnCancelGuiDownload_Click" />
                                    </StackPanel>
                                </ui:CardControl>

                                <Border x:Name="GuiDownloadProgressCard"
                                        Visibility="Collapsed"
                                        Background="{DynamicResource SystemFillColorAttentionBackgroundBrush}"
                                        BorderBrush="{DynamicResource CardBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        Padding="14,10"
                                        Margin="0,0,0,3">
                                    <StackPanel>
                                        <TextBlock x:Name="TxtGuiDownloadStatus" FontSize="12"
                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                   Margin="0,0,0,6" />
                                        <ProgressBar x:Name="PbGuiDownload" Height="4" Minimum="0" Maximum="100" Value="0" />
                                    </StackPanel>
                                </Border>

                                <ui:CardControl Icon="{ui:SymbolIcon ArrowDownload24, FontSize=18}" Margin="0,0,0,3">
                                    <ui:CardControl.Header>
                                        <StackPanel>
                                            <TextBlock Text="{Binding GuiUpdateAutoTitle, Source={x:Static local:Strings.Instance}}" Style="{StaticResource CardTitleTextStyle}" />
                                            <TextBlock Text="{Binding GuiUpdateAutoDesc, Source={x:Static local:Strings.Instance}}" Style="{StaticResource CardDescTextStyle}" />
                                        </StackPanel>
                                    </ui:CardControl.Header>
                                    <ui:ToggleSwitch x:Name="TglAutoUpdateGui" IsChecked="True"
                                                     Checked="SettingsToggle_Changed" Unchecked="SettingsToggle_Changed" />
                                </ui:CardControl>

                                <ui:CardExpander x:Name="CardGuiVersions"
                                                 Icon="{ui:SymbolIcon Clock24, FontSize=18}"
                                                 IsExpanded="False"
                                                 ContentPadding="0"
                                                 Margin="0,0,0,3">
                                    <ui:CardExpander.Header>
                                        <StackPanel>
                                            <TextBlock Text="{Binding GuiVersionsTitle, Source={x:Static local:Strings.Instance}}" Style="{StaticResource CardTitleTextStyle}" />
                                            <TextBlock x:Name="TxtGuiVersionsDesc" Style="{StaticResource CardDescTextStyle}" />
                                        </StackPanel>
                                    </ui:CardExpander.Header>
                                    <StackPanel>
                                        <TextBlock x:Name="TxtGuiReleasesEmpty"
                                                   Text="{Binding GuiVersionsEmpty, Source={x:Static local:Strings.Instance}}"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                   Margin="48,12,16,12" />
                                        <StackPanel x:Name="GuiReleasesHost" />
                                    </StackPanel>
                                </ui:CardExpander>

                                <!-- Section: Scanner Core -->
                                <TextBlock Text="{Binding CoreSectionHeader, Source={x:Static local:Strings.Instance}}"
                                           Style="{StaticResource SectionHeaderTextStyle}" />

                                <ui:CardControl Icon="{ui:SymbolIcon FolderOpen24, FontSize=18}" Margin="0,0,0,3">
                                    <ui:CardControl.Header>
                                        <StackPanel>
                                            <TextBlock Text="{Binding CoreBinaryTitle, Source={x:Static local:Strings.Instance}}" Style="{StaticResource CardTitleTextStyle}" />
                                            <TextBlock Text="{Binding CoreBinaryDesc, Source={x:Static local:Strings.Instance}}" Style="{StaticResource CardDescTextStyle}" />
                                        </StackPanel>
                                    </ui:CardControl.Header>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <ui:TextBox x:Name="TxtCorePath"
                                                    Width="220"
                                                    FontFamily="{StaticResource AppMonoFont}"
                                                    PlaceholderText="{Binding CorePathPlaceholder, Source={x:Static local:Strings.Instance}}"
                                                    Margin="0,0,8,0"
                                                    LostFocus="TxtCorePath_LostFocus"
                                                    KeyDown="TxtCorePath_KeyDown" />
                                        <ui:Button x:Name="BtnBrowseCore"
                                                   Content="{Binding BtnBrowse, Source={x:Static local:Strings.Instance}}"
                                                   Appearance="Secondary" Height="32" Padding="12,0" FontSize="13"
                                                   Click="BtnBrowseCore_Click" />
                                    </StackPanel>
                                </ui:CardControl>

                                <ui:CardControl Icon="{ui:SymbolIcon ArrowSync24, FontSize=18}" Margin="0,0,0,3">
                                    <ui:CardControl.Header>
                                        <StackPanel>
                                            <TextBlock Text="{Binding CoreUpdateTitle, Source={x:Static local:Strings.Instance}}" Style="{StaticResource CardTitleTextStyle}" />
                                            <TextBlock x:Name="TxtCoreVersionCard"
                                                       Text="{Binding CoreVersionChecking, Source={x:Static local:Strings.Instance}}"
                                                       Style="{StaticResource CardDescTextStyle}" />
                                        </StackPanel>
                                    </ui:CardControl.Header>
                                    <ui:Button x:Name="BtnCheckDownloadCore"
                                               Content="{Binding BtnCheckUpdates, Source={x:Static local:Strings.Instance}}"
                                               Appearance="Secondary" Height="32" Padding="12,0" FontSize="13"
                                               Click="BtnUpdateCore_Click" />
                                </ui:CardControl>

                                <!-- Section: Cloudflare WARP Account -->
                                <TextBlock Text="{Binding AccountSectionHeader, Source={x:Static local:Strings.Instance}}"
                                           Style="{StaticResource SectionHeaderTextStyle}" />

                                <ui:CardControl Icon="{ui:SymbolIcon Key24, FontSize=18}" Margin="0,0,0,3">
                                    <ui:CardControl.Header>
                                        <StackPanel>
                                            <TextBlock Text="{Binding AccountKeyTitle, Source={x:Static local:Strings.Instance}}" Style="{StaticResource CardTitleTextStyle}" />
                                            <TextBlock x:Name="TxtAccountDetails"
                                                       Text="{Binding AccountChecking, Source={x:Static local:Strings.Instance}}"
                                                       FontFamily="{StaticResource AppMonoFont}"
                                                       Style="{StaticResource CardDescTextStyle}" />
                                        </StackPanel>
                                    </ui:CardControl.Header>
                                    <ui:Button x:Name="BtnRegisterAccount"
                                               Content="{Binding BtnRegenerateKey, Source={x:Static local:Strings.Instance}}"
                                               Appearance="Secondary" Height="32" Padding="12,0" FontSize="13"
                                               Click="BtnRegisterAccount_Click" />
                                </ui:CardControl>

                                <!-- Section: App Preferences -->
                                <TextBlock Text="{Binding AppSectionHeader, Source={x:Static local:Strings.Instance}}"
                                           Style="{StaticResource SectionHeaderTextStyle}" />

                                <ui:CardControl Icon="{ui:SymbolIcon LocalLanguage24, FontSize=18}" Margin="0,0,0,3">
                                    <ui:CardControl.Header>
                                        <StackPanel>
                                            <TextBlock Text="{Binding LanguageTitle, Source={x:Static local:Strings.Instance}}" Style="{StaticResource CardTitleTextStyle}" />
                                            <TextBlock Text="{Binding LanguageDesc, Source={x:Static local:Strings.Instance}}" Style="{StaticResource CardDescTextStyle}" />
                                        </StackPanel>
                                    </ui:CardControl.Header>
                                    <ComboBox x:Name="CmbLanguage" Width="176" SelectedIndex="0" FontSize="13"
                                              SelectionChanged="CmbLanguage_SelectionChanged">
                                        <ComboBoxItem Tag="ru" Content="Русский (RU)" />
                                        <ComboBoxItem Tag="en" Content="English (EN)" />
                                    </ComboBox>
                                </ui:CardControl>

                                <ui:CardControl Icon="{ui:SymbolIcon AppGeneric24, FontSize=18}" Margin="0,0,0,3">
                                    <ui:CardControl.Header>
                                        <StackPanel>
                                            <TextBlock Text="{Binding TrayTitle, Source={x:Static local:Strings.Instance}}" Style="{StaticResource CardTitleTextStyle}" />
                                            <TextBlock Text="{Binding TrayDesc, Source={x:Static local:Strings.Instance}}" Style="{StaticResource CardDescTextStyle}" />
                                        </StackPanel>
                                    </ui:CardControl.Header>
                                    <ui:ToggleSwitch x:Name="TglMinimizeToTray" IsChecked="False"
                                                     Checked="SettingsToggle_Changed" Unchecked="SettingsToggle_Changed" />
                                </ui:CardControl>

                                <ui:CardControl Icon="{ui:SymbolIcon PlugConnected24, FontSize=18}" Margin="0,0,0,3">
                                    <ui:CardControl.Header>
                                        <StackPanel>
                                            <TextBlock Text="{Binding TrayWithProxyTitle, Source={x:Static local:Strings.Instance}}" Style="{StaticResource CardTitleTextStyle}" />
                                            <TextBlock Text="{Binding TrayWithProxyDesc, Source={x:Static local:Strings.Instance}}" Style="{StaticResource CardDescTextStyle}" />
                                        </StackPanel>
                                    </ui:CardControl.Header>
                                    <ui:ToggleSwitch x:Name="TglMinimizeToTrayWithProxy" IsChecked="True"
                                                     Checked="SettingsToggle_Changed" Unchecked="SettingsToggle_Changed" />
                                </ui:CardControl>

                                <ui:CardControl Icon="{ui:SymbolIcon Alert24, FontSize=18}" Margin="0,0,0,3">
                                    <ui:CardControl.Header>
                                        <StackPanel>
                                            <TextBlock Text="{Binding WarnExitTitle, Source={x:Static local:Strings.Instance}}" Style="{StaticResource CardTitleTextStyle}" />
                                            <TextBlock Text="{Binding WarnExitDesc, Source={x:Static local:Strings.Instance}}" Style="{StaticResource CardDescTextStyle}" />
                                        </StackPanel>
                                    </ui:CardControl.Header>
                                    <ui:ToggleSwitch x:Name="TglWarnOnExit" IsChecked="False"
                                                     Checked="SettingsToggle_Changed" Unchecked="SettingsToggle_Changed" />
                                </ui:CardControl>
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Grid>

        <!-- GUI Update / Rollback Confirmation Modal -->
        <Grid x:Name="GuiUpdateConfirmOverlay"
              Grid.RowSpan="2"
              Background="#AA000000"
              Visibility="Collapsed">
            <Border Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
                    BorderBrush="{DynamicResource CardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Width="460"
                    Padding="24"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock x:Name="TxtGuiConfirmTitle"
                               FontSize="16" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                               Margin="0,0,0,8" TextWrapping="Wrap" />
                    <TextBlock x:Name="TxtGuiConfirmBody"
                               FontSize="13"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap" Margin="0,0,0,14" />
                    <Border x:Name="GuiConfirmWarningBox"
                            Visibility="Collapsed"
                            Background="{DynamicResource SystemFillColorCautionBackgroundBrush}"
                            BorderBrush="{DynamicResource CardBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="10,8"
                            Margin="0,0,0,14">
                        <TextBlock x:Name="TxtGuiConfirmWarning"
                                   Text="{Binding GuiConfirmActiveProcesses, Source={x:Static local:Strings.Instance}}"
                                   FontSize="12"
                                   Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                   TextWrapping="Wrap" />
                    </Border>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <ui:Button Content="{Binding BtnCancel, Source={x:Static local:Strings.Instance}}"
                                   Appearance="Secondary" Height="32" Padding="14,0" FontSize="13"
                                   Margin="0,0,8,0"
                                   Click="BtnGuiConfirmCancel_Click" />
                        <ui:Button Content="{Binding BtnApplyAndRestart, Source={x:Static local:Strings.Instance}}"
                                   Appearance="Primary" Height="32" Padding="14,0" FontSize="13"
                                   Click="BtnGuiConfirmOk_Click" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Exit Warning Modal Dialog -->
        <Grid x:Name="ExitWarningOverlay"
              Grid.RowSpan="2"
              Background="#AA000000"
              Visibility="Collapsed">
            <Border Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
                    BorderBrush="{DynamicResource CardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Width="440"
                    Padding="24"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="{Binding ExitModalTitle, Source={x:Static local:Strings.Instance}}"
                               FontSize="16" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                               Margin="0,0,0,8" />
                    <TextBlock Text="{Binding ExitModalBody, Source={x:Static local:Strings.Instance}}"
                               FontSize="13"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap" Margin="0,0,0,14" />
                    <CheckBox x:Name="ChkRememberExitChoice"
                              Content="{Binding ExitRemember, Source={x:Static local:Strings.Instance}}"
                              FontSize="13"
                              Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                              Margin="0,0,0,18" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <ui:Button Content="{Binding BtnCancel, Source={x:Static local:Strings.Instance}}"
                                   Appearance="Secondary" Height="32" Padding="12,0" FontSize="13"
                                   Margin="0,0,8,0"
                                   Click="BtnExitCancel_Click" />
                        <ui:Button Content="{Binding BtnExitAndStop, Source={x:Static local:Strings.Instance}}"
                                   Appearance="Secondary" Height="32" Padding="12,0" FontSize="13"
                                   Margin="0,0,8,0"
                                   Click="BtnExitConfirm_Click" />
                        <ui:Button Content="{Binding BtnMinimizeTray, Source={x:Static local:Strings.Instance}}"
                                   Appearance="Primary" Height="32" Padding="14,0" FontSize="13"
                                   Click="BtnExitMinimize_Click" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</ui:FluentWindow>
